"use client";

import React, { useState, useRef, useEffect, useCallback } from "react";
import Link from "next/link";

interface CropArea {
  x: number;
  y: number;
  width: number;
  height: number;
}

export default function PhotoCropPage() {
  const [step, setStep] = useState<"upload" | "crop">("upload");
  const [imageSrc, setImageSrc] = useState<string>("");
  const [fileName, setFileName] = useState<string>("photo");
  const [isProcessing, setIsProcessing] = useState<boolean>(false);

  // प्रीसेट साइज़
  const [photoPreset, setPhotoPreset] = useState<string>("passport");
  const [aspectRatio, setAspectRatio] = useState<number | null>(3.5 / 4.5);

  // एडजस्टमेंट्स
  const [rotation, setRotation] = useState<number>(0);
  const [zoom, setZoom] = useState<number>(1);
  const [brightness, setBrightness] = useState<number>(100);
  const [contrast, setContrast] = useState<number>(100);
  const [saturation, setSaturation] = useState<number>(100);

  // क्रॉप बॉक्स
  const [cropBox, setCropBox] = useState<CropArea>({ x: 15, y: 15, width: 70, height: 70 });
  const [isDragging, setIsDragging] = useState<boolean>(false);
  const [dragStart, setDragStart] = useState<{ x: number; y: number }>({ x: 0, y: 0 });

  const imgElementRef = useRef<HTMLImageElement | null>(null);

  // फ़ाइल अपलोड हैंडलर
  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setFileName(file.name.replace(/\.[^/.]+$/, ""));
    const reader = new FileReader();
    reader.onload = (ev) => {
      setImageSrc(ev.target?.result as string);
      setStep("crop");
      setCropBox({ x: 15, y: 10, width: 70, height: 80 });
    };
    reader.readAsDataURL(file);
  };

  // पिक्सेल-लेवल मिरर फ्लिप (कैनवस से 100% इनवर्ट)
  const handleMirrorFlip = () => {
    if (!imageSrc) return;
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      const c = document.createElement("canvas");
      c.width = img.naturalWidth;
      c.height = img.naturalHeight;
      const ctx = c.getContext("2d");
      if (!ctx) return;
      ctx.translate(c.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(img, 0, 0);
      setImageSrc(c.toDataURL("image/jpeg", 0.98));
    };
    img.src = imageSrc;
  };

  // प्रीसेट चेंज
  const handlePresetChange = (preset: string) => {
    setPhotoPreset(preset);
    if (preset === "passport") setAspectRatio(3.5 / 4.5);
    else if (preset === "stamp") setAspectRatio(2.5 / 3.0);
    else if (preset === "2x2") setAspectRatio(1);
    else if (preset === "4x6") setAspectRatio(4 / 6);
    else setAspectRatio(null);
  };

  // रेंडर फ़ाइनल कैनवस
  const renderCanvas = useCallback(async (): Promise<HTMLCanvasElement | null> => {
    if (!imgElementRef.current || !imageSrc) return null;
    const img = imgElementRef.current;

    const natW = img.naturalWidth;
    const natH = img.naturalHeight;

    const cropX = (cropBox.x / 100) * natW;
    const cropY = (cropBox.y / 100) * natH;
    const cropW = (cropBox.width / 100) * natW;
    const cropH = (cropBox.height / 100) * natH;

    const canvas = document.createElement("canvas");
    canvas.width = Math.max(10, Math.round(cropW));
    canvas.height = Math.max(10, Math.round(cropH));
    const ctx = canvas.getContext("2d");
    if (!ctx) return null;

    ctx.save();
    if (saturation === 0) {
      ctx.filter = `grayscale(100%) brightness(${brightness}%) contrast(${contrast}%)`;
    } else {
      ctx.filter = `brightness(${brightness}%) contrast(${contrast}%) saturate(${saturation}%)`;
    }

    ctx.drawImage(
      img,
      cropX, cropY, cropW, cropH,
      0, 0, canvas.width, canvas.height
    );
    ctx.restore();

    return canvas;
  }, [imageSrc, cropBox, brightness, contrast, saturation]);

  // डाउनलोड ओरिजिनल HD
  const downloadJPG = async () => {
    setIsProcessing(true);
    try {
      const canvas = await renderCanvas();
      if (!canvas) return;
      canvas.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${fileName}_cropped_HD.jpg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, "image/jpeg", 0.98);
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 pb-16">
      {/* टॉप नेविगेशन हेडर */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div className="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <Link href="/tools" className="text-sm font-bold text-slate-600 hover:text-slate-900">
              ← टूल्स
            </Link>
            <span className="text-slate-300">|</span>
            <h1 className="text-base font-extrabold text-slate-800">फ़ोटो क्रॉपर (Photo Studio)</h1>
          </div>

          {/* मोड स्विचिंग टैब्स */}
          <div className="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
            <span className="py-1.5 px-3 rounded-lg text-xs font-black bg-white text-indigo-700 shadow-sm">
              📷 फ़ोटो मोड
            </span>
            <Link
              href="/tools/doc-crop"
              className="py-1.5 px-3 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition"
            >
              📄 डॉक्यूमेंट मोड
            </Link>
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-4 py-6">
        {step === "upload" ? (
          /* अपलोड स्क्रीन */
          <div className="max-w-xl mx-auto mt-12 bg-white p-8 rounded-3xl border border-slate-200 shadow-sm text-center">
            <div className="w-16 h-16 bg-red-50 text-red-600 rounded-2xl flex items-center justify-center mx-auto text-3xl mb-4">
              📷
            </div>
            <h2 className="text-xl font-black text-slate-800">पासपोर्ट व फ़ोटो क्रॉपर</h2>
            <p className="text-xs text-slate-500 mt-2 mb-6">
              पासपोर्ट साइज़, स्टाम्प या 4×6 फोटो को ओरिजिनल HD क्वालिटी में क्रॉप और ट्यून करें
            </p>

            <label
              htmlFor="photo-file"
              className="block w-full py-4 px-6 rounded-2xl font-black text-sm text-white shadow-lg cursor-pointer transition active:scale-95 bg-red-600 hover:bg-red-700 shadow-red-200"
            >
              📁 फ़ोटो चुनें (Upload Image)
            </label>
            <input
              id="photo-file"
              type="file"
              accept="image/*"
              onChange={handleFileUpload}
              className="sr-only"
            />
          </div>
        ) : (
          /* क्रॉप और एडजस्टमेंट वर्कस्पेस */
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {/* साइडबार: टूल्स और सेटिंग्स */}
            <div className="lg:col-span-1 space-y-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
              <div>
                <span className="text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-2">
                  फ़ोटो साइज़ प्रीसेट
                </span>
                <div className="grid grid-cols-2 gap-2">
                  {[
                    { id: "passport", label: "पासपोर्ट (3.5×4.5 cm)" },
                    { id: "stamp", label: "स्टाम्प (2.5×3.0 cm)" },
                    { id: "2x2", label: "2×2 इंच (Square)" },
                    { id: "4x6", label: "4×6 पोस्टकार्ड" },
                  ].map((p) => (
                    <button
                      key={p.id}
                      type="button"
                      onClick={() => handlePresetChange(p.id)}
                      className={`py-2 px-2 rounded-xl text-xs font-bold border transition ${
                        photoPreset === p.id
                          ? "bg-red-50 border-red-500 text-red-700"
                          : "border-slate-200 text-slate-700 hover:bg-slate-50"
                      }`}
                    >
                      {p.label}
                    </button>
                  ))}
                </div>
              </div>

              {/* मिरर फ्लिप व रोटेशन */}
              <div className="pt-3 border-t border-slate-100 space-y-3">
                <span className="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">
                  ट्रांसफ़ॉर्मेशन टूल्स
                </span>

                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-700">मिरर व्यू</span>
                  <button
                    type="button"
                    onClick={handleMirrorFlip}
                    className="py-1.5 px-3 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 active:scale-95 transition"
                  >
                    ↔️ मिरर फ्लिप (Flip)
                  </button>
                </div>

                <div>
                  <div className="flex justify-between text-xs font-bold text-slate-700 mb-1">
                    <span>🔄 रोटेशन</span>
                    <span>{rotation}°</span>
                  </div>
                  <input
                    type="range"
                    min="-180"
                    max="180"
                    value={rotation}
                    onChange={(e) => setRotation(Number(e.target.value))}
                    className="w-full accent-slate-800 cursor-pointer"
                  />
                </div>

                <div>
                  <div className="flex justify-between text-xs font-bold text-slate-700 mb-1">
                    <span>🔍 ज़ूम</span>
                    <span>{zoom.toFixed(1)}x</span>
                  </div>
                  <input
                    type="range"
                    min="0.5"
                    max="3"
                    step="0.1"
                    value={zoom}
                    onChange={(e) => setZoom(Number(e.target.value))}
                    className="w-full accent-slate-800 cursor-pointer"
                  />
                </div>
              </div>

              {/* कलर ट्यूनिंग स्लाइडर्स */}
              <div className="pt-3 border-t border-slate-100 space-y-3">
                <span className="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">
                  कलर व लाइट एडजस्टमेंट
                </span>

                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <div className="flex justify-between text-xs font-bold text-slate-700 mb-1">
                      <span>☀️ चमक</span>
                      <span>{brightness}%</span>
                    </div>
                    <input
                      type="range"
                      min="50"
                      max="150"
                      value={brightness}
                      onChange={(e) => setBrightness(Number(e.target.value))}
                      className="w-full accent-slate-800 cursor-pointer"
                    />
                  </div>

                  <div>
                    <div className="flex justify-between text-xs font-bold text-slate-700 mb-1">
                      <span>🌓 गहराई</span>
                      <span>{contrast}%</span>
                    </div>
                    <input
                      type="range"
                      min="50"
                      max="150"
                      value={contrast}
                      onChange={(e) => setContrast(Number(e.target.value))}
                      className="w-full accent-slate-800 cursor-pointer"
                    />
                  </div>
                </div>

                <div>
                  <div className="flex justify-between text-xs font-bold text-slate-700 mb-1">
                    <span>🎨 रंग (Saturation)</span>
                    <span>{saturation}%</span>
                  </div>
                  <input
                    type="range"
                    min="0"
                    max="200"
                    value={saturation}
                    onChange={(e) => setSaturation(Number(e.target.value))}
                    className="w-full accent-slate-800 cursor-pointer"
                  />
                  <div className="flex justify-between text-[10px] text-slate-400 mt-0.5">
                    <span>0% (B&W)</span>
                    <span>100% (नॉर्मल)</span>
                    <span>200% (गहरा)</span>
                  </div>
                </div>
              </div>

              {/* डाउनलोड बटन */}
              <div className="pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={downloadJPG}
                  disabled={isProcessing}
                  className="w-full py-3.5 px-4 bg-red-600 hover:bg-red-700 active:scale-95 text-white font-black text-sm rounded-xl shadow-md transition flex flex-col items-center justify-center"
                >
                  <span>📥 डाउनलोड JPG</span>
                  <span className="text-[10px] font-normal opacity-90">(ओरिजिनल HD - No Compression)</span>
                </button>

                <button
                  type="button"
                  onClick={() => setStep("upload")}
                  className="w-full mt-2 py-2 text-xs font-bold text-slate-500 hover:text-slate-700 text-center"
                >
                  नई फोटो चुनें
                </button>
              </div>
            </div>

            {/* मुख्य प्रीव्यू एरिया */}
            <div className="lg:col-span-2 bg-slate-900 rounded-2xl p-4 flex items-center justify-center min-h-[500px] overflow-hidden relative">
              <div className="relative inline-block max-h-[68vh] max-w-full">
                <img
                  ref={imgElementRef}
                  src={imageSrc}
                  alt="Crop Target"
                  className="max-h-[68vh] w-auto max-w-full object-contain pointer-events-none select-none block transition-transform duration-150"
                  style={{
                    filter:
                      saturation === 0
                        ? `grayscale(100%) brightness(${brightness}%) contrast(${contrast}%)`
                        : `brightness(${brightness}%) contrast(${contrast}%) saturate(${saturation}%)`,
                    transform: `rotate(${rotation}deg) scale(${zoom})`,
                    transformOrigin: "center center",
                  }}
                />

                {/* क्रॉप बॉक्स ओवरले */}
                <div
                  className="absolute border-2 border-dashed border-red-500 bg-red-500/10 cursor-move"
                  style={{
                    left: `${cropBox.x}%`,
                    top: `${cropBox.y}%`,
                    width: `${cropBox.width}%`,
                    height: `${cropBox.height}%`,
                  }}
                >
                  <div className="absolute top-1 left-1 bg-red-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded shadow">
                    क्रॉप एरिया
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
