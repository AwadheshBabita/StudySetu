"use client";

import React, { useState, useRef, useCallback } from "react";
import Link from "next/link";

interface CropArea {
  x: number;      // प्रतिशत (%)
  y: number;
  width: number;
  height: number;
}

export default function ExamSewaCropper() {
  // 3-स्टेप वर्कफ़्लो: 'upload' -> 'crop' -> 'adjust'
  const [currentStep, setCurrentStep] = useState<"upload" | "crop" | "adjust">("upload");

  // इमेज और फ़ाइल स्टेट्स
  const [originalSrc, setOriginalSrc] = useState<string>("");
  const [croppedSrc, setCroppedSrc] = useState<string>("");
  const [fileName, setFileName] = useState<string>("document");

  // स्टेप 2: क्रॉपिंग के समय ज़ूम और क्रॉप बॉक्स
  const [cropZoom, setCropZoom] = useState<number>(1);
  const [cropBox, setCropBox] = useState<CropArea>({ x: 20, y: 20, width: 60, height: 60 });
  const [isDragging, setIsDragging] = useState<boolean>(false);
  const [dragStart, setDragStart] = useState<{ x: number; y: number }>({ x: 0, y: 0 });

  const rawImgRef = useRef<HTMLImageElement | null>(null);
  const cropContainerRef = useRef<HTMLDivElement | null>(null);

  // स्टेप 3: मोड (फोटो मोड डिफ़ॉल्ट)
  const [activeMode, setActiveMode] = useState<"photo" | "doc">("photo");

  // स्टेप 3: एडजस्टमेंट स्टेट्स
  const [rotation, setRotation] = useState<number>(0);
  const [brightness, setBrightness] = useState<number>(100);
  const [contrast, setContrast] = useState<number>(100);
  const [saturation, setSaturation] = useState<number>(100);
  const [docFilter, setDocFilter] = useState<"original" | "magic" | "bw">("original");

  // ================= 1. फ़ाइल अपलोड =================
  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setFileName(file.name.replace(/\.[^/.]+$/, ""));
    const reader = new FileReader();
    reader.onload = (ev) => {
      setOriginalSrc(ev.target?.result as string);
      setCurrentStep("crop");
      setCropZoom(1);
      setCropBox({ x: 15, y: 15, width: 70, height: 70 });
    };
    reader.readAsDataURL(file);
  };

  // ================= 2. क्रॉप बॉक्स ड्रैगिंग =================
  const handleMouseDown = (e: React.MouseEvent) => {
    e.preventDefault();
    setIsDragging(true);
    setDragStart({ x: e.clientX, y: e.clientY });
  };

  const handleMouseMove = (e: React.MouseEvent) => {
    if (!isDragging || !cropContainerRef.current) return;
    const rect = cropContainerRef.current.getBoundingClientRect();
    const deltaX = ((e.clientX - dragStart.x) / rect.width) * 100;
    const deltaY = ((e.clientY - dragStart.y) / rect.height) * 100;

    setCropBox((prev) => ({
      ...prev,
      x: Math.max(0, Math.min(100 - prev.width, prev.x + deltaX)),
      y: Math.max(0, Math.min(100 - prev.height, prev.y + deltaY)),
    }));
    setDragStart({ x: e.clientX, y: e.clientY });
  };

  const handleMouseUp = () => setIsDragging(false);

  // टच इवेंट्स (मोबाइल के लिए)
  const handleTouchStart = (e: React.TouchEvent) => {
    if (e.touches.length === 1) {
      setIsDragging(true);
      setDragStart({ x: e.touches[0].clientX, y: e.touches[0].clientY });
    }
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (!isDragging || !cropContainerRef.current || e.touches.length !== 1) return;
    const rect = cropContainerRef.current.getBoundingClientRect();
    const deltaX = ((e.touches[0].clientX - dragStart.x) / rect.width) * 100;
    const deltaY = ((e.touches[0].clientY - dragStart.y) / rect.height) * 100;

    setCropBox((prev) => ({
      ...prev,
      x: Math.max(0, Math.min(100 - prev.width, prev.x + deltaX)),
      y: Math.max(0, Math.min(100 - prev.height, prev.y + deltaY)),
    }));
    setDragStart({ x: e.touches[0].clientX, y: e.touches[0].clientY });
  };

  // ================= 3. क्रॉप एक्ज़ीक्यूट करना (कैनवस से असली कटाई) =================
  const executeCrop = () => {
    if (!rawImgRef.current) return;
    const img = rawImgRef.current;
    const natW = img.naturalWidth;
    const natH = img.naturalHeight;

    const cropX = (cropBox.x / 100) * natW;
    const cropY = (cropBox.y / 100) * natH;
    const cropW = (cropBox.width / 100) * natW;
    const cropH = (cropBox.height / 100) * natH;

    const canvas = document.createElement("canvas");
    canvas.width = Math.max(10, Math.round(cropW));
    canvas.height = Math.max(10, Math.round(cropH));
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    ctx.drawImage(img, cropX, cropY, cropW, cropH, 0, 0, canvas.width, canvas.height);
    setCroppedSrc(canvas.toDataURL("image/png"));
    
    // रीसेट एडजस्टमेंट्स और स्टेप 3 में जाना
    setRotation(0);
    setBrightness(100);
    setContrast(100);
    setSaturation(100);
    setDocFilter("original");
    setCurrentStep("adjust");
  };

  // ================= 4. पिक्सेल मिरर फ्लिप (फोटो मोड) =================
  const handleMirrorFlip = () => {
    if (!croppedSrc) return;
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      const c = document.createElement("canvas");
      c.width = img.naturalWidth;
      c.height = img.naturalHeight;
      const ctx = c.getContext("2d");
      if (!ctx) return;
      ctx.translate(c.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(img, 0, 0);
      setCroppedSrc(c.toDataURL("image/png"));
    };
    img.src = croppedSrc;
  };

  // 90 डिग्री घुमाना
  const handleRotate90 = () => {
    setRotation((prev) => (prev + 90) % 360);
  };

  // ================= 5. फाइनल डाउनलोड (HD JPG) =================
  const handleDownload = () => {
    if (!croppedSrc) return;
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      const c = document.createElement("canvas");
      // रोटेशन चेक
      const isSideways = rotation % 180 !== 0;
      c.width = isSideways ? img.naturalHeight : img.naturalWidth;
      c.height = isSideways ? img.naturalWidth : img.naturalHeight;
      const ctx = c.getContext("2d");
      if (!ctx) return;

      ctx.save();
      ctx.translate(c.width / 2, c.height / 2);
      ctx.rotate((rotation * Math.PI) / 180);

      // फ़िल्टर अप्लाई
      if (activeMode === "photo") {
        if (saturation === 0) {
          ctx.filter = `grayscale(100%) brightness(${brightness}%) contrast(${contrast}%)`;
        } else {
          ctx.filter = `brightness(${brightness}%) contrast(${contrast}%) saturate(${saturation}%)`;
        }
      } else {
        if (docFilter === "bw") {
          ctx.filter = "grayscale(100%) contrast(180%) brightness(110%)";
        } else if (docFilter === "magic") {
          ctx.filter = "contrast(140%) brightness(105%) saturate(120%)";
        }
      }

      ctx.drawImage(img, -img.naturalWidth / 2, -img.naturalHeight / 2);
      ctx.restore();

      c.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${fileName}_${activeMode}_HD.jpg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, "image/jpeg", 0.98);
    };
    img.src = croppedSrc;
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col select-none">
      {/* शीर्ष हेडर */}
      <header className="bg-slate-900/90 backdrop-blur border-b border-slate-800 px-4 py-3 sticky top-0 z-50 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Link href="/tools" className="text-xs font-semibold text-slate-400 hover:text-white transition">
            ← टूल्स
          </Link>
          <span className="text-slate-700">|</span>
          <h1 className="text-sm font-extrabold text-white tracking-wide">
            ExamSewa Photo & Document Cropper
          </h1>
        </div>

        {/* स्टेप 3 में मोड स्विच बटन */}
        {currentStep === "adjust" && (
          <div className="flex items-center bg-slate-950 p-1 rounded-xl border border-slate-800">
            <button
              type="button"
              onClick={() => setActiveMode("photo")}
              className={`py-1 px-3 rounded-lg text-xs font-black transition flex items-center gap-1.5 ${
                activeMode === "photo"
                  ? "bg-red-600 text-white shadow"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              <span>📷</span>
              <span>फ़ोटो मोड</span>
            </button>
            <button
              type="button"
              onClick={() => setActiveMode("doc")}
              className={`py-1 px-3 rounded-lg text-xs font-black transition flex items-center gap-1.5 ${
                activeMode === "doc"
                  ? "bg-blue-600 text-white shadow"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              <span>📄</span>
              <span>डॉक्यूमेंट मोड</span>
            </button>
          </div>
        )}
      </header>

      {/* ==================== 1. अपलोड स्क्रीन ==================== */}
      {currentStep === "upload" && (
        <main className="flex-1 flex items-center justify-center p-4">
          <div className="bg-slate-900 border-2 border-dashed border-slate-700 hover:border-red-500 rounded-3xl p-8 max-w-lg w-full text-center shadow-2xl transition">
            <div className="w-20 h-20 bg-red-600/10 text-red-500 rounded-2xl flex items-center justify-center mx-auto text-4xl mb-4 border border-red-500/20">
              📁
            </div>
            <h2 className="text-xl font-black text-white">फ़ाइल चुनें</h2>
            <p className="text-xs text-slate-400 mt-2 mb-6 leading-relaxed">
              पूरा A4 पेज, मार्कशीट, फॉर्म, फोटो या हस्ताक्षर चुनें। 
              अगले स्टेप में आप ज़ूम करके अपने मनपसंद हिस्से को आसानी से काट सकेंगे।
            </p>

            <label
              htmlFor="file-input"
              className="block w-full py-4 px-6 rounded-2xl font-black text-sm text-white shadow-lg cursor-pointer transition active:scale-95 bg-red-600 hover:bg-red-700 shadow-red-600/30 text-center"
            >
              📁 फ़ाइल चुनें (Select File)
            </label>
            <input
              id="file-input"
              type="file"
              accept="image/*"
              onChange={handleFileUpload}
              className="sr-only"
            />
          </div>
        </main>
      )}

      {/* ==================== 2. केवल क्रॉपिंग स्क्रीन ==================== */}
      {currentStep === "crop" && (
        <main className="flex-1 flex flex-col p-3 sm:p-4 max-w-6xl w-full mx-auto">
          {/* ऊपर टूलबार: सिर्फ ज़ूम इन, ज़ूम आउट और क्रॉप बटन */}
          <div className="flex items-center justify-between bg-slate-900 border border-slate-800 px-4 py-2.5 rounded-2xl mb-3">
            <div className="flex items-center gap-2">
              <span className="text-xs font-bold text-slate-400 hidden sm:inline">ज़ूम:</span>
              <button
                type="button"
                onClick={() => setCropZoom((z) => Math.max(0.5, z - 0.25))}
                className="py-1 px-2.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-xs font-bold rounded-lg text-slate-200 border border-slate-700"
              >
                ➖ ज़ूम आउट
              </button>
              <span className="text-xs font-mono font-bold text-amber-400 min-w-12 text-center">
                {Math.round(cropZoom * 100)}%
              </span>
              <button
                type="button"
                onClick={() => setCropZoom((z) => Math.min(4, z + 0.25))}
                className="py-1 px-2.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-xs font-bold rounded-lg text-slate-200 border border-slate-700"
              >
                ➕ ज़ूम इन
              </button>
              <button
                type="button"
                onClick={() => setCropZoom(1)}
                className="py-1 px-2 bg-slate-800 hover:bg-slate-700 text-[11px] font-bold rounded-lg text-slate-400 hover:text-white"
              >
                100%
              </button>
            </div>

            {/* मुख्य क्रॉप एक्शन बटन */}
            <button
              type="button"
              onClick={executeCrop}
              className="py-2 px-5 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-black text-xs sm:text-sm rounded-xl shadow-lg shadow-emerald-900/30 transition flex items-center gap-1.5"
            >
              <span>✂️</span>
              <span>क्रॉप करें और आगे बढ़ें →</span>
            </button>
          </div>

          {/* पूरा A4 कैनवस जिसमें ड्रैगेबल क्रॉप बॉक्स है */}
          <div
            ref={cropContainerRef}
            onMouseMove={handleMouseMove}
            onMouseUp={handleMouseUp}
            onTouchMove={handleTouchMove}
            onTouchEnd={handleMouseUp}
            className="flex-1 bg-slate-950 rounded-2xl border border-slate-800 p-4 flex items-center justify-center overflow-auto relative min-h-[60vh]"
          >
            <div
              className="relative inline-block"
              style={{
                transform: `scale(${cropZoom})`,
                transformOrigin: "center center",
                transition: "transform 0.1s ease-out",
              }}
            >
              <img
                ref={rawImgRef}
                src={originalSrc}
                alt="Target Document"
                className="max-h-[70vh] w-auto max-w-full object-contain pointer-events-none select-none block shadow-2xl rounded"
              />

              {/* इंटरएक्टिव क्रॉप बॉक्स */}
              <div
                onMouseDown={handleMouseDown}
                onTouchStart={handleTouchStart}
                className="absolute cursor-move border-2 border-dashed border-emerald-400 bg-emerald-500/20 shadow-2xl"
                style={{
                  left: `${cropBox.x}%`,
                  top: `${cropBox.y}%`,
                  width: `${cropBox.width}%`,
                  height: `${cropBox.height}%`,
                }}
              >
                <div className="absolute top-1 left-1 bg-emerald-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded shadow">
                  क्रॉप एरिया (खींचकर सेट करें)
                </div>
              </div>
            </div>
          </div>
        </main>
      )}

      {/* ==================== 3. एडजस्टमेंट और फाइनल डाउनलोड ==================== */}
      {currentStep === "adjust" && (
        <main className="flex-1 flex flex-col lg:grid lg:grid-cols-3 gap-4 p-3 sm:p-4 max-w-7xl w-full mx-auto">
          {/* 
            लेआउट नियम: 
            • PC पर: 2 कॉलम चौड़ा प्रीव्यू (lg:col-span-2)
            • मोबाइल पर: ऊपर आधी स्क्रीन (h-[45vh]), नीचे टूल्स स्क्रॉल होंगे
          */}
          <div className="lg:col-span-2 bg-slate-900 rounded-2xl border border-slate-800 p-4 flex items-center justify-center relative min-h-[45vh] lg:min-h-[75vh] overflow-hidden">
            <div className="relative flex items-center justify-center">
              <img
                src={croppedSrc}
                alt="Cropped Preview"
                className="max-h-[40vh] lg:max-h-[68vh] w-auto max-w-full object-contain block shadow-2xl rounded"
                style={{
                  transform: `rotate(${rotation}deg)`,
                  filter:
                    activeMode === "photo"
                      ? saturation === 0
                        ? `grayscale(100%) brightness(${brightness}%) contrast(${contrast}%)`
                        : `brightness(${brightness}%) contrast(${contrast}%) saturate(${saturation}%)`
                      : docFilter === "bw"
                      ? "grayscale(100%) contrast(180%) brightness(110%)"
                      : docFilter === "magic"
                      ? "contrast(140%) brightness(105%) saturate(120%)"
                      : "none",
                }}
              />
            </div>
            <div className="absolute top-3 left-3 bg-slate-950/80 border border-slate-800 text-[10px] font-bold px-2 py-1 rounded text-slate-300">
              कटा हुआ प्रीव्यू ({activeMode === "photo" ? "फोटो मोड" : "डॉक्यूमेंट मोड"})
            </div>
          </div>

          {/* 
            दायाँ हिस्सा (PC) / नीचे का हिस्सा (मोबाइल):
            सारे बटन्स और एडजस्टमेंट स्लाइडर्स
          */}
          <div className="lg:col-span-1 bg-slate-900 rounded-2xl border border-slate-800 p-5 flex flex-col justify-between space-y-4 overflow-y-auto max-h-[80vh]">
            <div className="space-y-4">
              {/* ट्रांसफ़ॉर्मेशन टूल्स (दोनों मोड में काम करेंगे) */}
              <div>
                <span className="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2">
                  रोटेशन व ओरिएंटेशन
                </span>
                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={handleRotate90}
                    className="py-2 px-3 bg-slate-800 hover:bg-slate-700 active:scale-95 text-xs font-bold rounded-xl border border-slate-700 flex items-center justify-center gap-1.5"
                  >
                    <span>🔄</span>
                    <span>90° घुमाएँ</span>
                  </button>
                  <button
                    type="button"
                    onClick={handleMirrorFlip}
                    className="py-2 px-3 bg-slate-800 hover:bg-slate-700 active:scale-95 text-xs font-bold rounded-xl border border-slate-700 flex items-center justify-center gap-1.5"
                  >
                    <span>↔️</span>
                    <span>मिरर फ्लिप</span>
                  </button>
                </div>
              </div>

              {/* एक्टिव मोड के अनुसार टूल्स */}
              {activeMode === "photo" ? (
                /* फ़ोटो मोड के टूल्स */
                <div className="pt-3 border-t border-slate-800 space-y-3">
                  <span className="text-[11px] font-bold text-red-400 uppercase tracking-wider block">
                    फोटो कलर व लाइट ट्यूनिंग
                  </span>

                  <div>
                    <div className="flex justify-between text-xs font-bold text-slate-300 mb-1">
                      <span>☀️ चमक (Brightness)</span>
                      <span>{brightness}%</span>
                    </div>
                    <input
                      type="range"
                      min="50"
                      max="150"
                      value={brightness}
                      onChange={(e) => setBrightness(Number(e.target.value))}
                      className="w-full accent-red-500 cursor-pointer"
                    />
                  </div>

                  <div>
                    <div className="flex justify-between text-xs font-bold text-slate-300 mb-1">
                      <span>🌓 गहराई (Contrast)</span>
                      <span>{contrast}%</span>
                    </div>
                    <input
                      type="range"
                      min="50"
                      max="150"
                      value={contrast}
                      onChange={(e) => setContrast(Number(e.target.value))}
                      className="w-full accent-red-500 cursor-pointer"
                    />
                  </div>

                  <div>
                    <div className="flex justify-between text-xs font-bold text-slate-300 mb-1">
                      <span>🎨 रंग (Saturation)</span>
                      <span>{saturation}%</span>
                    </div>
                    <input
                      type="range"
                      min="0"
                      max="200"
                      value={saturation}
                      onChange={(e) => setSaturation(Number(e.target.value))}
                      className="w-full accent-red-500 cursor-pointer"
                    />
                    <div className="flex justify-between text-[10px] text-slate-500 mt-0.5">
                      <span>0% (B&W)</span>
                      <span>100% (नॉर्मल)</span>
                      <span>200% (गहरा)</span>
                    </div>
                  </div>
                </div>
              ) : (
                /* डॉक्यूमेंट मोड के टूल्स */
                <div className="pt-3 border-t border-slate-800 space-y-3">
                  <span className="text-[11px] font-bold text-blue-400 uppercase tracking-wider block">
                    दस्तावेज़ फ़िल्टर
                  </span>

                  <div className="grid grid-cols-3 gap-2">
                    <button
                      type="button"
                      onClick={() => setDocFilter("original")}
                      className={`p-2 rounded-xl text-xs font-bold border transition ${
                        docFilter === "original"
                          ? "bg-blue-600 border-blue-500 text-white"
                          : "bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700"
                      }`}
                    >
                      ओरिजिनल
                    </button>
                    <button
                      type="button"
                      onClick={() => setDocFilter("magic")}
                      className={`p-2 rounded-xl text-xs font-bold border transition ${
                        docFilter === "magic"
                          ? "bg-blue-600 border-blue-500 text-white"
                          : "bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700"
                      }`}
                    >
                      मैजिक कलर
                    </button>
                    <button
                      type="button"
                      onClick={() => setDocFilter("bw")}
                      className={`p-2 rounded-xl text-xs font-bold border transition ${
                        docFilter === "bw"
                          ? "bg-blue-600 border-blue-500 text-white"
                          : "bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700"
                      }`}
                    >
                      ब्लैक & व्हाइट
                    </button>
                  </div>
                  <p className="text-[11px] text-slate-400">
                    {docFilter === "bw"
                      ? "काले अक्षरों को गहरा और बैकग्राउंड को साफ़ सफ़ेद करेगा।"
                      : docFilter === "magic"
                      ? "दस्तावेज़ के रंगों और लिखावट को साफ़ उभारेगा।"
                      : "मूल स्कैन किया हुआ रंग रखेगा।"}
                  </p>
                </div>
              )}
            </div>

            {/* डाउनलोड और दोबारा क्रॉप के बटन */}
            <div className="pt-4 border-t border-slate-800 space-y-2">
              <button
                type="button"
                onClick={handleDownload}
                className="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-black text-sm rounded-xl shadow-lg shadow-emerald-900/40 transition flex items-center justify-center gap-2"
              >
                <span>📥</span>
                <span>डाउनलोड JPG (ओरिजिनल HD)</span>
              </button>

              <button
                type="button"
                onClick={() => setCurrentStep("crop")}
                className="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl transition"
              >
                ↩️ दोबारा क्रॉप करें
              </button>

              <button
                type="button"
                onClick={() => setCurrentStep("upload")}
                className="w-full py-1 text-[11px] text-slate-500 hover:text-slate-300 transition text-center"
              >
                नई फ़ाइल अपलोड करें
              </button>
            </div>
          </div>
        </main>
      )}
    </div>
  );
}
