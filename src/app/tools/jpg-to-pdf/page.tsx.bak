'use client';

import React, { useState, useRef } from 'react';
import { jsPDF } from 'jspdf';
import FaqSection from '@/components/FaqSection';

interface UploadedImg {
  id: string;
  name: string;
  src: string;
}

export default function JpgToPdfPage() {
  const [images, setImages] = useState<UploadedImg[]>([]);
  const [generating, setGenerating] = useState<boolean>(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const jpgToPdfFaqs = [
    {
      q: "क्या कई फोटो जोड़कर एक सिंगल A4 PDF बनाई जा सकती है?",
      a: "हाँ, आप अपनी मार्कशीट, आधार कार्ड, निवास प्रमाण-पत्र या कई पन्नों के नोट्स की अलग-अलग तस्वीरों को एक साथ जोड़कर 1-क्लिक में एक ही A4 साइज PDF में बदल सकते हैं।"
    },
    {
      q: "क्या PDF बनाते समय फोटो का क्रम बदला जा सकता है?",
      a: "हाँ, आप अपलोड की गई तस्वीरों को अपनी इच्छानुसार ऊपर या नीचे (Reorder) कर सकते हैं, ताकि PDF में पन्ने सही क्रम में आएँ।"
    },
    {
      q: "क्या मेरे निजी दस्तावेज़ इंटरनेट पर लीक होने का खतरा है?",
      a: "बिल्कुल नहीं। यह टूल 100% क्लाइंट-साइड (jsPDF) पर काम करता है। आपकी फाइलें सीधे आपके फ़ोन की मेमोरी में प्रोसेस होती हैं।"
    }
  ];

  const handleFiles = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (!files || files.length === 0) return;

    Array.from(files).forEach((file) => {
      const reader = new FileReader();
      reader.onload = () => {
        setImages((prev) => [
          ...prev,
          {
            id: Math.random().toString(36).substring(2, 9),
            name: file.name,
            src: reader.result as string,
          },
        ]);
      };
      reader.readAsDataURL(file);
    });
  };

  const removeImage = (id: string) => {
    setImages((prev) => prev.filter((img) => img.id !== id));
  };

  const moveImage = (index: number, direction: 'up' | 'down') => {
    const targetIdx = direction === 'up' ? index - 1 : index + 1;
    if (targetIdx < 0 || targetIdx >= images.length) return;
    const newArr = [...images];
    const temp = newArr[index];
    newArr[index] = newArr[targetIdx];
    newArr[targetIdx] = temp;
    setImages(newArr);
  };

  const generatePdf = async () => {
    if (images.length === 0) return;
    setGenerating(true);

    try {
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageWidth = 210;
      const pageHeight = 297;

      for (let i = 0; i < images.length; i++) {
        if (i > 0) pdf.addPage();

        const img = new Image();
        img.src = images[i].src;
        await new Promise((res) => { img.onload = res; });

        const imgWidth = img.naturalWidth;
        const imgHeight = img.naturalHeight;
        const ratio = Math.min((pageWidth - 20) / imgWidth, (pageHeight - 20) / imgHeight);

        const printW = imgWidth * ratio;
        const printH = imgHeight * ratio;
        const x = (pageWidth - printW) / 2;
        const y = (pageHeight - printH) / 2;

        pdf.addImage(img, 'JPEG', x, y, printW, printH);
      }

      pdf.save('documents_examsewa.pdf');
    } catch (err) {
      console.error(err);
      alert('PDF तैयार करने में त्रुटि आई।');
    } finally {
      setGenerating(false);
    }
  };

  return (
    <div className="max-w-3xl mx-auto px-4 py-8">
      <div className="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        
        <div className="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full mb-3">
          दस्तावेज़ कनवर्टर • A4 साइज
        </div>
        <h1 className="text-2xl sm:text-3xl font-black text-slate-900 mb-2">
          JPG से PDF बनाएँ (Image to PDF)
        </h1>
        <p className="text-sm text-slate-600 mb-6">
          मार्कशीट, नोट्स या फोटो को एक साथ जोड़कर 1-क्लिक में साफ-सुथरी A4 साइज PDF फ़ाइल बनाएँ।
        </p>

        <div className="border-2 border-dashed border-slate-300 rounded-2xl p-6 text-center bg-slate-50 hover:bg-slate-100 transition mb-6">
          <input
            type="file"
            accept="image/*"
            multiple
            ref={fileInputRef}
            onChange={handleFiles}
            className="hidden"
          />
          <button
            type="button"
            onClick={() => fileInputRef.current?.click()}
            className="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl shadow-xs transition"
          >
            📑 फोटो / मार्कशीट चुनें (एक या कई)
          </button>
          <p className="text-xs text-slate-500 mt-2">
            एक से अधिक फोटो एक साथ चुन सकते हैं
          </p>
        </div>

        {images.length > 0 && (
          <div className="space-y-3 mb-6">
            <h3 className="text-xs font-bold text-slate-700 uppercase">
              चुनी गई फाइलें ({images.length} पेज):
            </h3>
            <div className="space-y-2">
              {images.map((item, idx) => (
                <div
                  key={item.id}
                  className="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200 rounded-xl"
                >
                  <div className="flex items-center gap-3 min-w-0">
                    <span className="w-6 h-6 flex items-center justify-center bg-slate-200 rounded text-xs font-bold text-slate-700">
                      {idx + 1}
                    </span>
                    <img
                      src={item.src}
                      alt="थंबनेल"
                      className="w-9 h-9 object-cover rounded border border-slate-300 shrink-0"
                    />
                    <span className="text-xs font-semibold text-slate-800 truncate">
                      {item.name}
                    </span>
                  </div>

                  <div className="flex items-center gap-1.5 shrink-0">
                    <button
                      onClick={() => moveImage(idx, 'up')}
                      disabled={idx === 0}
                      className="p-1 px-2 text-xs font-bold bg-white border border-slate-300 rounded disabled:opacity-40"
                    >
                      ↑
                    </button>
                    <button
                      onClick={() => moveImage(idx, 'down')}
                      disabled={idx === images.length - 1}
                      className="p-1 px-2 text-xs font-bold bg-white border border-slate-300 rounded disabled:opacity-40"
                    >
                      ↓
                    </button>
                    <button
                      onClick={() => removeImage(item.id)}
                      className="p-1 px-2 text-xs font-bold text-red-600 bg-white border border-red-200 rounded hover:bg-red-50"
                    >
                      ✕
                    </button>
                  </div>
                </div>
              ))}
            </div>

            <button
              onClick={generatePdf}
              disabled={generating}
              className="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl transition shadow-sm text-sm flex items-center justify-center gap-2 mt-4"
            >
              <span>{generating ? '⏳ PDF तैयार हो रही है...' : '📥 A4 PDF डाउनलोड करें'}</span>
            </button>
          </div>
        )}

      </div>

      <FaqSection 
        title="JPG से PDF - अक्सर पूछे जाने वाले सवाल"
        items={jpgToPdfFaqs}
        pageUrl="https://examsewa.online/tools/jpg-to-pdf"
      />

    </div>
  );
}
