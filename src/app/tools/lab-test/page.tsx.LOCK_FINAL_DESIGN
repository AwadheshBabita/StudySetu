"use client";

import React, { useState, useRef } from "react";
import Link from "next/link";

export default function LabTestOptimizer() {
  const [originalImage, setOriginalImage] = useState<string | null>(null);
  const [compressedImage, setCompressedImage] = useState<string | null>(null);
  const [originalSize, setOriginalSize] = useState<number>(0);
  const [compressedSize, setCompressedSize] = useState<number>(0);
  const [quality, setQuality] = useState<number>(80);
  const [zoomLevel, setZoomLevel] = useState<number>(1);
  const [smartScale, setSmartScale] = useState<boolean>(true);
  const [dimensions, setDimensions] = useState<{ width: number; height: number }>({ width: 0, height: 0 });
  const [fileName, setFileName] = useState<string>("optimized-image");

  const fileInputRef = useRef<HTMLInputElement>(null);
  const imageElementRef = useRef<HTMLImageElement | null>(null);

  const origBoxRef = useRef<HTMLDivElement>(null);
  const compBoxRef = useRef<HTMLDivElement>(null);
  const isSyncingRef = useRef<boolean>(false);

  const syncScroll = (source: HTMLDivElement | null, target: HTMLDivElement | null) => {
    if (!source || !target || isSyncingRef.current) return;
    isSyncingRef.current = true;
    target.scrollTop = source.scrollTop;
    target.scrollLeft = source.scrollLeft;
    requestAnimationFrame(() => {
      isSyncingRef.current = false;
    });
  };

  const handleBackToUpload = () => {
    setOriginalImage(null);
    setCompressedImage(null);
    setOriginalSize(0);
    setCompressedSize(0);
    setZoomLevel(1);
    if (fileInputRef.current) {
      fileInputRef.current.value = "";
    }
  };

  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setOriginalSize(file.size);
    setFileName(file.name.replace(/\.[^/.]+$/, ""));
    setZoomLevel(1);

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        setDimensions({ width: img.width, height: img.height });
        imageElementRef.current = img;
        setOriginalImage(event.target?.result as string);
        runEngine(img, quality, smartScale);
      };
      img.src = event.target?.result as string;
    };
    reader.readAsDataURL(file);
  };

  const runEngine = (img: HTMLImageElement, q: number, enableSmartScale: boolean) => {
    let targetWidth = img.width;
    let targetHeight = img.height;

    if (enableSmartScale) {
      const maxDimension = 1600;
      if (img.width > maxDimension || img.height > maxDimension) {
        if (img.width > img.height) {
          targetWidth = maxDimension;
          targetHeight = Math.round((img.height * maxDimension) / img.width);
        } else {
          targetHeight = maxDimension;
          targetWidth = Math.round((img.width * maxDimension) / img.height);
        }
      }
    }

    const canvas = document.createElement("canvas");
    canvas.width = targetWidth;
    canvas.height = targetHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.drawImage(img, 0, 0, targetWidth, targetHeight);

    const factor = Math.max(0.01, Math.min(1.0, q / 100));
    canvas.toBlob(
      (blob) => {
        if (!blob) return;
        setCompressedSize(blob.size);
        setCompressedImage(URL.createObjectURL(blob));
      },
      "image/jpeg",
      factor
    );
  };

  const handleQualityChange = (newQ: number) => {
    setQuality(newQ);
    if (imageElementRef.current) {
      runEngine(imageElementRef.current, newQ, smartScale);
    }
  };

  const toggleSmartScale = (checked: boolean) => {
    setSmartScale(checked);
    if (imageElementRef.current) {
      runEngine(imageElementRef.current, quality, checked);
    }
  };

  const zoomIn = () => setZoomLevel((prev) => Math.min(prev + 0.5, 4));
  const zoomOut = () => setZoomLevel((prev) => Math.max(prev - 0.5, 1));
  const resetZoom = () => {
    setZoomLevel(1);
    if (origBoxRef.current) {
      origBoxRef.current.scrollTop = 0;
      origBoxRef.current.scrollLeft = 0;
    }
    if (compBoxRef.current) {
      compBoxRef.current.scrollTop = 0;
      compBoxRef.current.scrollLeft = 0;
    }
  };

  const downloadJPG = () => {
    if (!compressedImage) return;
    const a = document.createElement("a");
    a.href = compressedImage;
    a.download = `${fileName}-optimized.jpg`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };

  const downloadPDF = () => {
    if (!compressedImage) return;
    const w = window.open("");
    if (w) {
      w.document.write(`<img src="${compressedImage}" style="max-width:100%;" onload="window.print();"/>`);
      w.document.close();
    }
  };

  const handleShare = async () => {
    if (!compressedImage) return;
    try {
      const res = await fetch(compressedImage);
      const blob = await res.blob();
      const file = new File([blob], `${fileName}.jpg`, { type: "image/jpeg" });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({ files: [file], title: "Optimized Photo" });
      } else {
        alert("फ़ाइल डाउनलोड करके शेयर करें।");
      }
    } catch (e) {}
  };

  const formatSize = (bytes: number) => {
    if (bytes === 0) return "0 KB";
    return (bytes / 1024).toFixed(1) + " KB";
  };

  return (
    <div className="min-h-screen bg-[#dbeafe]/40 text-slate-800 flex flex-col p-2 sm:p-4 md:p-6 font-sans">
      {/* Header */}
      <header className="flex items-center justify-between pb-3 border-b border-slate-300 max-w-5xl mx-auto w-full">
        <div className="flex items-center gap-2.5">
          <Link href="/" className="p-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 shadow-sm transition">
            <svg className="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
          </Link>
          <div>
            <div className="flex items-center gap-2">
              <h1 className="text-base sm:text-lg font-bold text-slate-900 tracking-tight">Live Image Optimizer</h1>
              <span className="text-[10px] bg-red-600 text-white px-2 py-0.5 rounded-full font-mono font-bold shadow-sm">TEST LAB</span>
            </div>
          </div>
        </div>

        {originalImage && (
          <button
            onClick={handleBackToUpload}
            className="flex items-center gap-1.5 text-xs bg-white hover:bg-slate-50 px-3.5 py-1.5 rounded-xl border border-slate-300 text-slate-700 font-bold shadow-sm active:scale-95 transition"
          >
            <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z" />
            </svg>
            <span>← बैक</span>
          </button>
        )}
      </header>

      {/* Main Area */}
      <main className="max-w-5xl mx-auto w-full flex-1 flex flex-col justify-start pt-3">
        {!originalImage ? (
          <div className="bg-white rounded-3xl p-4 sm:p-6 md:p-8 border border-slate-200 shadow-xl shadow-blue-500/5 flex flex-col gap-6">
            
            {/* Top Row: Title, Icon & 3 Trust Badges */}
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-3">
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/30 flex-shrink-0">
                  <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 11v6m0-6l-2 2m2-2l2 2" />
                  </svg>
                </div>
                <div>
                  <h2 className="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">अपनी फ़ाइल चुनें</h2>
                  <p className="text-xs sm:text-sm text-slate-500 font-medium">फ़ाइल अपलोड करें और तुरंत प्रीव्यू देखें</p>
                </div>
              </div>

              {/* Badges on right side */}
              <div className="flex items-center gap-2 flex-wrap">
                <div className="flex items-center gap-1.5 bg-rose-50 text-rose-700 border border-rose-200/60 px-3 py-1 rounded-full text-xs font-semibold">
                  <span className="w-2 h-2 rounded-full bg-rose-500"></span>
                  <span>सुरक्षित (100% Private)</span>
                </div>
                <div className="flex items-center gap-1 bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-3 py-1 rounded-full text-xs font-semibold">
                  <span>⚡ तेज़ अपलोड</span>
