              <div className="h-[2px] w-full md:h-auto md:w-[2px] bg-blue-500"></div>

              <div className="flex-1 flex flex-col min-w-0">
                <div className="flex justify-between items-center px-3 py-1 bg-blue-50/50 border-b border-blue-100 text-[11px] font-mono">
                  <span className="text-blue-600 font-bold">👁️ लाइव प्रीव्यू</span>
                  <span className="bg-blue-600 text-white px-2 py-0.2 rounded font-bold">
                    {formatSize(compressedSize)}
                  </span>
                </div>
                <div
                  ref={compBoxRef}
                  onScroll={() => syncScroll(compBoxRef.current, origBoxRef.current)}
                  className="h-[210px] sm:h-[260px] p-2 bg-slate-50/50 overflow-auto select-none"
                >
                  <div style={{ width: `${zoomLevel * 100}%`, margin: "0 auto" }}>
                    {compressedImage && (
                      <img
                        src={compressedImage}
                        alt="Preview"
                        className="w-full h-auto object-contain object-top pointer-events-none block"
                      />
                    )}
                  </div>
                </div>
              </div>
            </div>

            <div className="bg-white border border-slate-300 rounded-xl p-3 flex flex-col gap-2.5 shadow-sm">
              <div className="flex items-center justify-between bg-blue-50/80 p-2 rounded-lg border border-blue-200">
                <label className="flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-800">
                  <input
                    type="checkbox"
                    checked={smartScale}
                    onChange={(e) => toggleSmartScale(e.target.checked)}
                    className="w-4 h-4 text-blue-600 accent-blue-600 rounded cursor-pointer"
                  />
                  <span>⚡ 2-चरण स्मार्ट स्केल (बड़ी फोटो के लिए बेस्ट क्वालिटी)</span>
                </label>
                <span className="text-[10px] font-mono bg-white px-1.5 py-0.5 rounded border border-blue-200 text-blue-700 font-bold">
                  {smartScale ? "ON" : "OFF"}
                </span>
              </div>

              <div className="flex flex-col gap-1 bg-slate-50 p-2 rounded-lg border border-slate-200">
                <div className="flex justify-between items-center text-xs">
                  <span className="font-semibold text-slate-700 flex items-center gap-1">
                    🔍 ज़ूम स्लाइडर (तुलना सिंक):
                  </span>
                  <div className="flex items-center gap-2">
                    <span className="font-mono text-blue-600 font-bold bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
                      {zoomLevel.toFixed(1)}x
                    </span>
                    {zoomLevel > 1 && (
                      <button
                        onClick={() => setZoomLevel(1)}
                        className="text-[10px] text-amber-600 font-bold hover:underline"
                      >
                        रीसेट (1x)
                      </button>
                    )}
                  </div>
                </div>
                <input
                  type="range"
                  min="1"
                  max="4"
                  step="0.1"
                  value={zoomLevel}
                  onChange={(e) => setZoomLevel(Number(e.target.value))}
                  className="w-full accent-blue-600 cursor-pointer h-2 bg-slate-200 rounded"
                />
              </div>

              <div className="flex flex-col gap-1">
                <div className="flex justify-between text-xs">
                  <span className="font-semibold text-slate-700">क्वालिटी व साइज़ एडजस्ट करें:</span>
                  <span className="font-mono text-blue-600 font-bold bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
                    {quality}%
                  </span>
                </div>
                <input
                  type="range"
                  min="2"
                  max="100"
                  value={quality}
                  onChange={(e) => handleQualityChange(Number(e.target.value))}
                  className="w-full accent-blue-600 cursor-pointer h-2 bg-slate-200 rounded"
                />
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1 border-t border-slate-200">
                <button
                  onClick={downloadJPG}
                  className="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 text-xs shadow-sm active:scale-95 transition"
                >
                  📥 सेव करें JPG ({formatSize(compressedSize)})
                </button>
                <button
                  onClick={downloadPDF}
                  className="bg-slate-700 hover:bg-slate-800 text-white font-semibold py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 text-xs shadow-sm active:scale-95 transition"
                >
                  📄 PDF में सेव करें
                </button>
                <button
                  onClick={handleShare}
                  className="bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 text-xs border border-slate-300 active:scale-95 transition"
                >
                  🔗 शेयर करें
                </button>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
