                    <div className="flex items-center justify-center gap-1 mt-1 text-[10px] text-blue-600 font-semibold">
                      <svg className="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"/></svg>
                      <span>Image</span>
                    </div>
                  </div>
                </div>

                {/* 2. PDF Document (document.pdf) */}
                <div
                  onClick={() => fileInputRef.current?.click()}
                  className="relative bg-white border border-slate-200 hover:border-rose-500 rounded-2xl p-2.5 flex flex-col cursor-pointer transition shadow-sm hover:shadow-md group"
                >
                  <div className="absolute top-3.5 right-3.5 z-10 w-5 h-5 rounded-full bg-slate-800/70 text-white flex items-center justify-center text-[10px] shadow">
                    ✕
                  </div>
                  <div className="w-full h-24 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center mb-2 overflow-hidden">
                    <div className="w-14 h-18 bg-white border border-slate-200 shadow-sm rounded-sm p-1.5 flex flex-col items-center">
