                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                </div>

                <div className="absolute -right-12 -top-1 bg-blue-600 text-white text-[11px] font-bold px-2 py-0.5 rounded shadow rotate-[12deg] group-hover:rotate-0 transition">
                  JPG
                </div>
              </div>

              <h3 className="text-lg sm:text-xl font-bold text-slate-800 mb-0.5">
                यहाँ फ़ाइल को खींचकर छोड़ें
              </h3>
              <p className="text-xs text-slate-400 font-medium mb-3">— या —</p>

              {/* Large Pill Button */}
              <div className="inline-flex items-center gap-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold px-7 sm:px-9 py-3 rounded-full shadow-lg shadow-blue-600/30 group-hover:shadow-blue-600/50 transition-all duration-200 active:scale-95">
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
                <span className="text-sm sm:text-base">फ़ाइल चुनें</span>
                <span className="w-6 h-6 rounded-full bg-white text-blue-600 flex items-center justify-center shadow-sm ml-1">
                  <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="3" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>

              <p className="text-xs text-slate-400 mt-4 font-medium">
                सपोर्टेड फ़ॉर्मेट: JPG, PNG, PDF, WebP &nbsp;|&nbsp; अधिकतम साइज़: 10 MB (प्रति फ़ाइल)
              </p>
            </div>

            {/* Bottom Section: Realistic Thumbnails Matching User Screenshot */}
            <div className="flex flex-col gap-3">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <span className="w-1.5 h-4 rounded-full bg-purple-600"></span>
                  <h4 className="text-sm font-bold text-slate-900">अपलोड की गई फ़ाइलें (4)</h4>
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-xs text-rose-500 font-semibold cursor-pointer hover:underline">🗑️ सभी हटाएं</span>
                  <span className="text-xs text-blue-600 font-semibold cursor-pointer hover:underline border border-blue-200 px-2 py-0.5 rounded-lg bg-blue-50">+ और फ़ाइल जोड़ें</span>
                </div>
              </div>

              {/* 4 Cards Grid With Realistic Demo Graphics */}
              <div className="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
                
                {/* 1. Mountain Landscape (photo.jpg) */}
                <div
                  onClick={() => fileInputRef.current?.click()}
                  className="relative bg-white border border-slate-200 hover:border-blue-500 rounded-2xl p-2.5 flex flex-col cursor-pointer transition shadow-sm hover:shadow-md group"
                >
                  <div className="absolute top-3.5 right-3.5 z-10 w-5 h-5 rounded-full bg-slate-800/70 text-white flex items-center justify-center text-[10px] shadow">
                    ✕
                  </div>
                  <div className="w-full h-24 rounded-xl overflow-hidden mb-2 bg-gradient-to-b from-sky-400 to-sky-100 flex items-end justify-center relative">
                    <svg className="w-full h-full object-cover" viewBox="0 0 160 90" preserveAspectRatio="none">
                      <rect width="160" height="90" fill="#38bdf8"/>
                      {/* Sun */}
                      <circle cx="130" cy="20" r="10" fill="#fef08a" />
                      {/* Mountains */}
                      <polygon points="10,65 50,25 90,65" fill="#475569"/>
