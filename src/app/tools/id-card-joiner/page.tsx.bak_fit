"use client";

import { useState, useRef, ChangeEvent } from "react";
import { PDFDocument } from "pdf-lib";

interface Point {
  x: number;
  y: number;
}

interface CardSideState {
  rawSrc: string | null;
  rotation: number;
  points: [Point, Point, Point, Point] | null; // TL, TR, BR, BL
  croppedCanvas: HTMLCanvasElement | null;
  brightness: number; // -50 to 50
  contrast: number;   // -50 to 50
}

export default function IdCardJoinerPage() {
  // Step Workflow: 1 = Crop & Straighten, 2 = Enhance, 3 = Final A4 Sheet & KB
  const [currentStep, setCurrentStep] = useState<1 | 2 | 3>(1);

  // Front & Back States
  const [front, setFront] = useState<CardSideState>({
    rawSrc: null,
    rotation: 0,
    points: null,
    croppedCanvas: null,
    brightness: 0,
    contrast: 0,
  });

  const [back, setBack] = useState<CardSideState>({
    rawSrc: null,
    rotation: 0,
    points: null,
    croppedCanvas: null,
    brightness: 0,
    contrast: 0,
  });

  const [activeSide, setActiveSide] = useState<"front" | "back">("front");
  const [draggingIndex, setDraggingIndex] = useState<number | null>(null);

  // Magnifier Lens
  const [magnifier, setMagnifier] = useState<{
    visible: boolean;
    x: number;
    y: number;
    label: string;
  }>({ visible: false, x: 0, y: 0, label: "" });

  // Step 3 Settings
  const [layoutMode, setLayoutMode] = useState<"side-by-side" | "stack-fold">("side-by-side");
  const [targetKb, setTargetKb] = useState<number>(300);
  const [isProcessing, setIsProcessing] = useState<boolean>(false);
  const [downloadJpgUrl, setDownloadJpgUrl] = useState<string | null>(null);
  const [downloadPdfUrl, setDownloadPdfUrl] = useState<string | null>(null);
  const [outputSizeKb, setOutputSizeKb] = useState<number | null>(null);

  const imageRef = useRef<HTMLImageElement | null>(null);
  const containerRef = useRef<HTMLDivElement | null>(null);
  const magnifierCanvasRef = useRef<HTMLCanvasElement | null>(null);

  const CARD_RATIO = 85.6 / 54.0; // 1.585

  // 1. Upload Handler
  const handleUpload = (e: ChangeEvent<HTMLInputElement>, side: "front" | "back") => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      const src = reader.result as string;
      const setter = side === "front" ? setFront : setBack;
      setter({
        rawSrc: src,
        rotation: 0,
        points: null,
        croppedCanvas: null,
        brightness: 0,
        contrast: 0,
      });
      setActiveSide(side);
      setCurrentStep(1);
    };
    reader.readAsDataURL(file);
  };

  // Rotate 90 deg
  const rotateImage = (side: "front" | "back") => {
    const setter = side === "front" ? setFront : setBack;
    setter((prev) => ({
      ...prev,
      rotation: (prev.rotation + 90) % 360,
      points: null,
      croppedCanvas: null,
    }));
  };

  // Initialize 4 independent corner points on image load
  const onImageLoad = () => {
    if (!imageRef.current) return;
    const img = imageRef.current;
    const nw = img.naturalWidth;
    const nh = img.naturalHeight;

    const padX = nw * 0.1;
    const padY = nh * 0.1;

    const currentPoints: [Point, Point, Point, Point] = [
      { x: padX, y: padY },               // Top-Left (0)
      { x: nw - padX, y: padY },          // Top-Right (1)
      { x: nw - padX, y: nh - padY },     // Bottom-Right (2)
      { x: padX, y: nh - padY },          // Bottom-Left (3)
    ];

    if (activeSide === "front" && !front.points) {
      setFront((p) => ({ ...p, points: currentPoints }));
    } else if (activeSide === "back" && !back.points) {
      setBack((p) => ({ ...p, points: currentPoints }));
    }
  };

  const currentData = activeSide === "front" ? front : back;
  const setCurrentPoints = (pts: [Point, Point, Point, Point]) => {
    if (activeSide === "front") setFront((p) => ({ ...p, points: pts }));
    else setBack((p) => ({ ...p, points: pts }));
  };

  // Magnifying Lens Rendering
  const updateMagnifier = (focusX: number, focusY: number, touchX: number, touchY: number, idx: number) => {
    const mCanvas = magnifierCanvasRef.current;
    const img = imageRef.current;
    if (!mCanvas || !img) return;

    const labels = ["ऊपरी बायाँ कोना", "ऊपरी दायाँ कोना", "निचला दायाँ कोना", "निचला बायाँ कोना"];

    setMagnifier({
      visible: true,
      x: Math.max(70, Math.min(window.innerWidth - 70, touchX)),
      y: Math.max(90, touchY - 80),
      label: labels[idx] || "कोना",
    });

    const ctx = mCanvas.getContext("2d");
    if (!ctx) return;

    mCanvas.width = 130;
    mCanvas.height = 130;
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.clearRect(0, 0, 130, 130);

    const zoom = 3.0;
    const sW = 130 / zoom;
    const sH = 130 / zoom;
    const sX = focusX - sW / 2;
    const sY = focusY - sH / 2;

    ctx.drawImage(img, sX, sY, sW, sH, 0, 0, 130, 130);

    // Crosshair target
    ctx.strokeStyle = "#e11d48";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(65, 40);
    ctx.lineTo(65, 90);
    ctx.moveTo(40, 65);
    ctx.lineTo(90, 65);
    ctx.stroke();

    ctx.fillStyle = "#e11d48";
    ctx.beginPath();
    ctx.arc(65, 65, 3.5, 0, Math.PI * 2);
    ctx.fill();
  };

  // Dragging individual points
  const handlePointDragStart = (index: number) => {
    setDraggingIndex(index);
  };

  const handlePointerMove = (clientX: number, clientY: number) => {
    if (draggingIndex === null || !currentData.points || !imageRef.current || !containerRef.current) return;

    const img = imageRef.current;
    const rect = img.getBoundingClientRect();
    const scaleX = img.naturalWidth / rect.width;
    const scaleY = img.naturalHeight / rect.height;

    const curImgX = Math.max(0, Math.min(img.naturalWidth, (clientX - rect.left) * scaleX));
    const curImgY = Math.max(0, Math.min(img.naturalHeight, (clientY - rect.top) * scaleY));

    const newPts: [Point, Point, Point, Point] = [...currentData.points] as [Point, Point, Point, Point];
    newPts[draggingIndex] = { x: curImgX, y: curImgY };

    updateMagnifier(curImgX, curImgY, clientX, clientY, draggingIndex);
    setCurrentPoints(newPts);
  };

  const handlePointerUp = () => {
    setDraggingIndex(null);
    setMagnifier({ visible: false, x: 0, y: 0, label: "" });
  };

  // Perspective Warp Core: Warps any 4 arbitrary points into clean 1011x638 300 DPI PVC
  const warpPerspectiveToCanvas = async (
    imgSrc: string,
    rot: number,
    pts: [Point, Point, Point, Point]
  ): Promise<HTMLCanvasElement> => {
    return new Promise((resolve) => {
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        // Rotate raw image first
        const rCanvas = document.createElement("canvas");
        const is90 = rot === 90 || rot === 270;
        rCanvas.width = is90 ? img.height : img.width;
        rCanvas.height = is90 ? img.width : img.height;
        const rCtx = rCanvas.getContext("2d")!;
        rCtx.translate(rCanvas.width / 2, rCanvas.height / 2);
        rCtx.rotate((rot * Math.PI) / 180);
        rCtx.drawImage(img, -img.width / 2, -img.height / 2);

        // Destination 300 DPI PVC size
        const dw = 1011;
        const dh = 638;
        const outCanvas = document.createElement("canvas");
        outCanvas.width = dw;
        outCanvas.height = dh;
        const outCtx = outCanvas.getContext("2d")!;

        // Subdivided Mesh Triangular Perspective Warp
        const [p0, p1, p2, p3] = pts;
        const subdivs = 16;

        for (let y = 0; y < subdivs; y++) {
          for (let x = 0; x < subdivs; x++) {
            const u0 = x / subdivs;
            const u1 = (x + 1) / subdivs;
            const v0 = y / subdivs;
            const v1 = (y + 1) / subdivs;

            // Bilinear interpolate source points
            const getSrcPt = (u: number, v: number): Point => {
              const topX = p0.x + (p1.x - p0.x) * u;
              const topY = p0.y + (p1.y - p0.y) * u;
              const botX = p3.x + (p2.x - p3.x) * u;
              const botY = p3.y + (p2.y - p3.y) * u;
              return {
                x: topX + (botX - topX) * v,
                y: topY + (botY - topY) * v,
              };
            };

            const srcA = getSrcPt(u0, v0);
            const srcB = getSrcPt(u1, v0);
            const srcC = getSrcPt(u0, v1);
            const srcD = getSrcPt(u1, v1);

            const dstX0 = u0 * dw;
            const dstX1 = u1 * dw;
            const dstY0 = v0 * dh;
            const dstY1 = v1 * dh;

            // Triangle 1 (A, B, C)
            renderTriangle(outCtx, rCanvas, srcA, srcB, srcC, { x: dstX0, y: dstY0 }, { x: dstX1, y: dstY0 }, { x: dstX0, y: dstY1 });
            // Triangle 2 (B, D, C)
            renderTriangle(outCtx, rCanvas, srcB, srcD, srcC, { x: dstX1, y: dstY0 }, { x: dstX1, y: dstY1 }, { x: dstX0, y: dstY1 });
          }
        }
        resolve(outCanvas);
      };
      img.src = imgSrc;
    });
  };

  // Helper: Affine render single triangle
  const renderTriangle = (
    ctx: CanvasRenderingContext2D,
    img: HTMLCanvasElement,
    s0: Point, s1: Point, s2: Point,
    d0: Point, d1: Point, d2: Point
  ) => {
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(d0.x, d0.y);
    ctx.lineTo(d1.x, d1.y);
    ctx.lineTo(d2.x, d2.y);
    ctx.closePath();
    ctx.clip();

    const denom = (s0.x * (s2.y - s1.y) - s1.x * s2.y + s2.x * s1.y + (s1.x - s2.x) * s0.y);
    if (Math.abs(denom) < 0.0001) {
      ctx.restore();
      return;
    }

    const m11 = - (s0.y * (d2.x - d1.x) - s1.y * d2.x + s2.y * d1.x + (s1.y - s2.y) * d0.x) / denom;
    const m12 = (s0.y * d2.y + s1.y * (d0.y - d2.y) - s2.y * d0.y + (s2.y - s1.y) * d1.y) / denom;
    const m21 = (s0.x * (d2.x - d1.x) - s1.x * d2.x + s2.x * d1.x + (s1.x - s2.x) * d0.x) / denom;
    const m22 = - (s0.x * d2.y + s1.x * (d0.y - d2.y) - s2.x * d0.y + (s2.x - s1.x) * d1.y) / denom;
    const dx = (s0.x * (s2.y * d1.x - s1.y * d2.x) + s0.y * (s1.x * d2.x - s2.x * d1.x) + (s2.x * s1.y - s1.x * s2.y) * d0.x) / denom;
    const dy = (s0.x * (s2.y * d1.y - s1.y * d2.y) + s0.y * (s1.x * d2.y - s2.x * d1.y) + (s2.x * s1.y - s1.x * s2.y) * d0.y) / denom;

    ctx.transform(m11, m12, m21, m22, dx, dy);
    ctx.drawImage(img, 0, 0);
    ctx.restore();
  };

  // STEP 1 COMPLETE -> Perform Perspective Straightening & Go to Step 2
  const handleStraightenAndGoToEnhance = async () => {
    if (!front.rawSrc || !back.rawSrc) {
      alert("कृपया दोनों फ़्रंट और बैक फ़ोटो अपलोड करें!");
      return;
    }
    if (!front.points || !back.points) {
      alert("कृपया दोनों साइड के 4 कोने सेट करें!");
      return;
    }

    setIsProcessing(true);
    try {
      const [frontWarped, backWarped] = await Promise.all([
        warpPerspectiveToCanvas(front.rawSrc, front.rotation, front.points),
        warpPerspectiveToCanvas(back.rawSrc, back.rotation, back.points),
      ]);

      setFront((p) => ({ ...p, croppedCanvas: frontWarped }));
      setBack((p) => ({ ...p, croppedCanvas: backWarped }));
      setCurrentStep(2);
    } catch (e) {
      console.error(e);
      alert("कार्ड को सीधा करने में समस्या आई।");
    } finally {
      setIsProcessing(false);
    }
  };

  // STEP 3: Final Master A4 Sheet + Target KB Engine
  const generateFinalSheet = async () => {
    if (!front.croppedCanvas || !back.croppedCanvas) return;
    setIsProcessing(true);

    try {
      // 1. Create enhanced side canvases
      const applyEnhancement = (canvas: HTMLCanvasElement, b: number, c: number): HTMLCanvasElement => {
        const out = document.createElement("canvas");
        out.width = canvas.width;
        out.height = canvas.height;
        const ctx = out.getContext("2d")!;
        const brightVal = 100 + b;
        const contrastVal = 100 + c;
        ctx.filter = `brightness(${brightVal}%) contrast(${contrastVal}%)`;
        ctx.drawImage(canvas, 0, 0);
        return out;
      };

      const finalFront = applyEnhancement(front.croppedCanvas, front.brightness, front.contrast);
      const finalBack = applyEnhancement(back.croppedCanvas, back.brightness, back.contrast);

      // 2. A4 Master Canvas: 2480 x 3508 px (300 DPI)
      const a4 = document.createElement("canvas");
      a4.width = 2480;
      a4.height = 3508;
      const ctx = a4.getContext("2d")!;

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, 2480, 3508);

      const cardW = 1011;
      const cardH = 638;
      const radius = 24;

      const drawSmartCard = (c: HTMLCanvasElement, x: number, y: number) => {
        ctx.save();
        ctx.beginPath();
        ctx.roundRect(x, y, cardW, cardH, radius);
        ctx.clip();
        ctx.drawImage(c, x, y, cardW, cardH);
        ctx.restore();

        // 1px Cutting guideline
        ctx.save();
        ctx.strokeStyle = "#cbd5e1";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.roundRect(x, y, cardW, cardH, radius);
        ctx.stroke();
        ctx.restore();
      };

      if (layoutMode === "side-by-side") {
        const gap = 120;
        const totalW = cardW * 2 + gap;
        const startX = (2480 - totalW) / 2;
        const startY = 320;
        drawSmartCard(finalFront, startX, startY);
        drawSmartCard(finalBack, startX + cardW + gap, startY);

        ctx.save();
        ctx.strokeStyle = "#e2e8f0";
        ctx.setLineDash([12, 12]);
        ctx.beginPath();
        ctx.moveTo(startX + cardW + gap / 2, startY - 40);
        ctx.lineTo(startX + cardW + gap / 2, startY + cardH + 40);
        ctx.stroke();
        ctx.restore();
      } else {
        const startX = (2480 - cardW) / 2;
        const startY = 320;
        drawSmartCard(finalFront, startX, startY);
        drawSmartCard(finalBack, startX, startY + cardH + 10);

        ctx.save();
        ctx.strokeStyle = "#94a3b8";
        ctx.setLineDash([8, 8]);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(startX - 30, startY + cardH + 5);
        ctx.lineTo(startX + cardW + 30, startY + cardH + 5);
        ctx.stroke();
        ctx.restore();
      }

      // 3. Exact Target KB Binary Loop
      const targetBytes = targetKb * 1024;
      let qLow = 0.05;
      let qHigh = 0.98;
      let bestBlob: Blob | null = null;

      for (let iter = 0; iter < 6; iter++) {
        const qMid = (qLow + qHigh) / 2;
        const b: Blob = await new Promise((res) => {
          a4.toBlob((blob) => res(blob!), "image/jpeg", qMid);
        });
        if (b.size <= targetBytes) {
          bestBlob = b;
          qLow = qMid;
        } else {
          qHigh = qMid;
        }
      }

      if (!bestBlob) {
        bestBlob = await new Promise((res) => {
          a4.toBlob((blob) => res(blob!), "image/jpeg", 0.1);
        });
      }

      setOutputSizeKb(Math.round(bestBlob!.size / 1024));
      if (downloadJpgUrl) URL.revokeObjectURL(downloadJpgUrl);
      setDownloadJpgUrl(URL.createObjectURL(bestBlob!));

      // 4. Generate 1:1 Scale Print PDF
      const pdfDoc = await PDFDocument.create();
      const jpgBytes = await bestBlob!.arrayBuffer();
      const embeddedJpg = await pdfDoc.embedJpg(jpgBytes);
      const pdfPage = pdfDoc.addPage([595.28, 841.89]);
      pdfPage.drawImage(embeddedJpg, {
        x: 0,
        y: 0,
        width: 595.28,
        height: 841.89,
      });

      const pdfBytes = await pdfDoc.save({ useObjectStreams: true });
      const pdfBlob = new Blob([pdfBytes], { type: "application/pdf" });
      if (downloadPdfUrl) URL.revokeObjectURL(downloadPdfUrl);
      setDownloadPdfUrl(URL.createObjectURL(pdfBlob));

    } catch (err) {
      console.error(err);
      alert("शीट तैयार करने में समस्या आई।");
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50/50 text-slate-800 py-8 px-4 sm:px-6 select-none">
      <div className="max-w-xl mx-auto space-y-6">

        {/* Header & Step Indicator */}
        <div className="text-center space-y-3">
          <span className="inline-flex items-center gap-1.5 bg-rose-50 text-rose-700 text-xs px-3 py-1 rounded-full font-bold border border-rose-100">
            <span className="w-2 h-2 rounded-full bg-rose-500"></span>
            3-स्टेप प्रोफेशनल PVC इंजन • 300 DPI Ultra HD
          </span>
          <h1 className="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            ID Card Cropper & Straightener
          </h1>

          {/* Stepper Wizard Bar */}
          <div className="flex items-center justify-between max-w-sm mx-auto pt-2">
            {[
              { num: 1, title: "1. तिरछा सीधा करें" },
              { num: 2, title: "2. लाइट व चमक" },
              { num: 3, title: "3. प्रिंट व KB" },
            ].map((s) => (
              <button
                key={s.num}
                type="button"
                onClick={() => {
                  if (s.num === 1) setCurrentStep(1);
                  if (s.num === 2 && front.croppedCanvas) setCurrentStep(2);
                  if (s.num === 3 && front.croppedCanvas) setCurrentStep(3);
                }}
                className={`flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl border transition ${
                  currentStep === s.num
                    ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                    : "bg-white text-slate-500 border-slate-200"
                }`}
              >
                <span>{s.title}</span>
              </button>
            ))}
          </div>
        </div>

        {/* ================= STEP 1: UPLOAD & 4-CORNER PERSPECTIVE CROP ================= */}
        {currentStep === 1 && (
          <div className="space-y-4">
            {/* Dual Upload */}
            <div className="grid grid-cols-2 gap-3">
              <div className="bg-white p-3 rounded-2xl border border-slate-200 text-center space-y-2">
                <div className="flex justify-between items-center">
                  <span className="text-xs font-bold text-slate-700">1. कार्ड फ़्रंट</span>
                  {front.rawSrc && (
                    <button
                      type="button"
                      onClick={() => rotateImage("front")}
                      className="text-[11px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md"
                    >
                      🔄 घुमाएँ
                    </button>
                  )}
                </div>
                <label className="block border-2 border-dashed border-slate-200 hover:border-rose-400 rounded-xl p-3 cursor-pointer bg-slate-50/50">
                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => handleUpload(e, "front")}
                    className="sr-only"
                  />
                  <span className="text-xs font-semibold text-slate-600 block truncate">
                    {front.rawSrc ? "✅ फ़्रंट अपलोड है" : "➕ फ़्रंट अपलोड"}
                  </span>
                </label>
              </div>

              <div className="bg-white p-3 rounded-2xl border border-slate-200 text-center space-y-2">
                <div className="flex justify-between items-center">
                  <span className="text-xs font-bold text-slate-700">2. कार्ड बैक</span>
                  {back.rawSrc && (
                    <button
                      type="button"
                      onClick={() => rotateImage("back")}
                      className="text-[11px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md"
                    >
                      🔄 घुमाएँ
                    </button>
                  )}
                </div>
                <label className="block border-2 border-dashed border-slate-200 hover:border-rose-400 rounded-xl p-3 cursor-pointer bg-slate-50/50">
                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => handleUpload(e, "back")}
                    className="sr-only"
                  />
                  <span className="text-xs font-semibold text-slate-600 block truncate">
                    {back.rawSrc ? "✅ बैक अपलोड है" : "➕ बैक अपलोड"}
                  </span>
                </label>
              </div>
            </div>

            {/* Switch Active Front/Back */}
            {(front.rawSrc || back.rawSrc) && (
              <div className="flex gap-2">
                <button
                  type="button"
                  onClick={() => setActiveSide("front")}
                  disabled={!front.rawSrc}
                  className={`flex-1 py-2 text-xs font-bold rounded-xl border transition ${
                    activeSide === "front"
                      ? "bg-rose-600 text-white border-rose-600"
                      : "bg-white text-slate-600 border-slate-200 disabled:opacity-40"
                  }`}
                >
                  फ़्रंट के 4 कोने सेट करें
                </button>
                <button
                  type="button"
                  onClick={() => setActiveSide("back")}
                  disabled={!back.rawSrc}
                  className={`flex-1 py-2 text-xs font-bold rounded-xl border transition ${
                    activeSide === "back"
                      ? "bg-rose-600 text-white border-rose-600"
                      : "bg-white text-slate-600 border-slate-200 disabled:opacity-40"
                  }`}
                >
                  बैक के 4 कोने सेट करें
                </button>
              </div>
            )}

            {/* Canvas Area with 4 Independent Corners + Magnifier */}
            {currentData.rawSrc && (
              <div className="bg-white p-4 rounded-3xl border border-slate-200 space-y-3">
                <div className="flex justify-between items-center text-xs text-slate-500 font-medium">
                  <span>📌 चारों कोनों को कार्ड के किनारों पर रखें</span>
                  <span className="text-rose-600 font-bold">मैग्नीफायर एक्टिव</span>
                </div>

                <div
                  ref={containerRef}
                  className="relative overflow-hidden rounded-2xl bg-slate-950 flex items-center justify-center min-h-[280px] touch-none"
                  onMouseMove={(e) => handlePointerMove(e.clientX, e.clientY)}
                  onMouseUp={handlePointerUp}
                  onTouchMove={(e) => handlePointerMove(e.touches[0].clientX, e.touches[0].clientY)}
                  onTouchEnd={handlePointerUp}
                >
                  <img
                    ref={imageRef}
                    src={currentData.rawSrc}
                    alt="Card"
                    onLoad={onImageLoad}
                    style={{ transform: `rotate(${currentData.rotation}deg)` }}
                    className="max-h-[380px] w-auto object-contain pointer-events-none transition-transform"
                  />

                  {/* Quad Polygon & 4 Independent Grips */}
                  {currentData.points && imageRef.current && (() => {
                    const img = imageRef.current;
                    const rect = img.getBoundingClientRect();
                    const containerRect = containerRef.current?.getBoundingClientRect();
                    if (!containerRect) return null;

                    const offX = rect.left - containerRect.left;
                    const offY = rect.top - containerRect.top;
                    const sx = rect.width / img.naturalWidth;
                    const sy = rect.height / img.naturalHeight;

                    const screenPts = currentData.points.map((p) => ({
                      x: offX + p.x * sx,
                      y: offY + p.y * sy,
                    }));

                    const polygonPath = `M ${screenPts[0].x} ${screenPts[0].y} L ${screenPts[1].x} ${screenPts[1].y} L ${screenPts[2].x} ${screenPts[2].y} L ${screenPts[3].x} ${screenPts[3].y} Z`;

                    return (
                      <>
                        <svg className="absolute inset-0 w-full h-full pointer-events-none z-10">
                          <path
                            d={polygonPath}
                            fill="rgba(225, 29, 72, 0.15)"
                            stroke="#e11d48"
                            strokeWidth="2"
                            strokeDasharray="6 4"
                          />
                        </svg>

                        {/* 4 Independent Touch Handles - Clean without TL/TR */}
                        {screenPts.map((pt, idx) => (
                          <div
                            key={idx}
                            style={{
                              left: `${pt.x - 14}px`,
                              top: `${pt.y - 14}px`,
                            }}
                            onMouseDown={(e) => {
                              e.stopPropagation();
                              handlePointDragStart(idx);
                            }}
                            onTouchStart={(e) => {
                              e.stopPropagation();
                              handlePointDragStart(idx);
                            }}
                            className="absolute z-20 w-7 h-7 rounded-full bg-white border-2 border-rose-600 shadow-xl cursor-crosshair active:scale-125 transition-transform flex items-center justify-center"
                          >
                            <span className="w-2 h-2 rounded-full bg-rose-600"></span>
                          </div>
                        ))}
                      </>
                    );
                  })()}

                  {/* Magnifying Glass Popup */}
                  <div
                    style={{
                      display: magnifier.visible ? "block" : "none",
                      left: `${magnifier.x - 65}px`,
                      top: `${magnifier.y - 65}px`,
                    }}
                    className="fixed pointer-events-none z-50 rounded-full border-4 border-rose-500 bg-white shadow-2xl overflow-hidden"
                  >
                    <canvas ref={magnifierCanvasRef} className="w-[130px] h-[130px]" />
                    <div className="absolute bottom-1 w-full text-center text-[9px] font-bold text-rose-700 bg-white/90 py-0.5">
                      {magnifier.label}
                    </div>
                  </div>
                </div>

                {/* Straighten & Next Step Button */}
                <button
                  type="button"
                  onClick={handleStraightenAndGoToEnhance}
                  disabled={!front.rawSrc || !back.rawSrc || isProcessing}
                  className="w-full py-3.5 bg-rose-600 hover:bg-rose-700 disabled:opacity-50 text-white font-bold rounded-2xl text-sm shadow-md transition flex items-center justify-center gap-2 cursor-pointer"
                >
                  {isProcessing ? (
                    <span>पर्स्पेक्टिव सीधा हो रहा है...</span>
                  ) : (
                    <span>➡️ तिरछा सीधा करें और स्टेप 2 पर जाएँ</span>
                  )}
                </button>
              </div>
            )}
          </div>
        )}

        {/* ================= STEP 2: BRIGHTNESS & CONTRAST ENHANCE ================= */}
        {currentStep === 2 && front.croppedCanvas && back.croppedCanvas && (
          <div className="bg-white p-5 rounded-3xl border border-slate-200 space-y-5">
            <div className="flex justify-between items-center border-b border-slate-100 pb-3">
              <div>
                <h3 className="font-bold text-slate-800 text-sm">स्टेप 2: कार्ड की चमक व डार्कनेस</h3>
                <p className="text-xs text-slate-400">धुंधली फ़ोटो को प्रिंट करने लायक साफ़ बनाएँ</p>
              </div>
              <button
                type="button"
                onClick={() => setCurrentStep(1)}
                className="text-xs text-rose-600 font-bold bg-rose-50 px-2.5 py-1 rounded-lg"
              >
                ⬅️ कोना दोबारा बदलें
              </button>
            </div>

            {/* Side Switcher */}
            <div className="flex gap-2">
              <button
                type="button"
                onClick={() => setActiveSide("front")}
                className={`flex-1 py-2 text-xs font-bold rounded-xl border transition ${
                  activeSide === "front" ? "bg-rose-600 text-white border-rose-600" : "bg-slate-50 text-slate-600 border-slate-200"
                }`}
              >
                फ़्रंट साइड सेटिंग्स
              </button>
              <button
                type="button"
                onClick={() => setActiveSide("back")}
                className={`flex-1 py-2 text-xs font-bold rounded-xl border transition ${
                  activeSide === "back" ? "bg-rose-600 text-white border-rose-600" : "bg-slate-50 text-slate-600 border-slate-200"
                }`}
              >
                बैक साइड सेटिंग्स
              </button>
            </div>

            {/* Live Filter Preview */}
            <div className="flex justify-center p-3 bg-slate-900 rounded-2xl">
              <img
                src={activeSide === "front" ? front.croppedCanvas.toDataURL() : back.croppedCanvas.toDataURL()}
                alt="Warped Preview"
                style={{
                  filter: `brightness(${100 + (activeSide === "front" ? front.brightness : back.brightness)}%) contrast(${100 + (activeSide === "front" ? front.contrast : back.contrast)}%)`,
                }}
                className="max-h-[160px] rounded-lg shadow-md"
              />
            </div>

            {/* Sliders */}
            <div className="space-y-4">
              <div className="space-y-1">
                <div className="flex justify-between text-xs font-bold text-slate-700">
                  <span>चमक (Brightness): {activeSide === "front" ? front.brightness : back.brightness}</span>
                  <button
                    type="button"
                    onClick={() => {
                      if (activeSide === "front") setFront((p) => ({ ...p, brightness: 0 }));
                      else setBack((p) => ({ ...p, brightness: 0 }));
                    }}
                    className="text-[10px] text-rose-600"
                  >
                    रीसेट
                  </button>
                </div>
                <input
                  type="range"
                  min="-50"
                  max="50"
                  value={activeSide === "front" ? front.brightness : back.brightness}
                  onChange={(e) => {
                    const val = Number(e.target.value);
                    if (activeSide === "front") setFront((p) => ({ ...p, brightness: val }));
                    else setBack((p) => ({ ...p, brightness: val }));
                  }}
                  className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-rose-600"
                />
              </div>

              <div className="space-y-1">
                <div className="flex justify-between text-xs font-bold text-slate-700">
                  <span>गहरापन (Contrast): {activeSide === "front" ? front.contrast : back.contrast}</span>
                  <button
                    type="button"
                    onClick={() => {
                      if (activeSide === "front") setFront((p) => ({ ...p, contrast: 0 }));
                      else setBack((p) => ({ ...p, contrast: 0 }));
                    }}
                    className="text-[10px] text-rose-600"
                  >
                    रीसेट
                  </button>
                </div>
                <input
                  type="range"
                  min="-50"
                  max="50"
                  value={activeSide === "front" ? front.contrast : back.contrast}
                  onChange={(e) => {
                    const val = Number(e.target.value);
                    if (activeSide === "front") setFront((p) => ({ ...p, contrast: val }));
                    else setBack((p) => ({ ...p, contrast: val }));
                  }}
                  className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-rose-600"
                />
              </div>
            </div>

            <button
              type="button"
              onClick={() => setCurrentStep(3)}
              className="w-full py-3.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-2xl text-sm shadow-md transition"
            >
              ➡️ स्टेप 3: A4 प्रिंट व KB साइज़ सेट करें
            </button>
          </div>
        )}

        {/* ================= STEP 3: A4 SHEET, KB SLIDER & DOWNLOAD ================= */}
        {currentStep === 3 && front.croppedCanvas && back.croppedCanvas && (
          <div className="bg-white p-5 rounded-3xl border border-slate-200 space-y-5">
            <div className="flex justify-between items-center border-b border-slate-100 pb-3">
              <div>
                <h3 className="font-bold text-slate-800 text-sm">स्टेप 3: प्रिंट शीट व साइज़ (KB)</h3>
                <p className="text-xs text-slate-400">10 से 500 KB के बीच फ़ाइनल प्रिंट निकालें</p>
              </div>
              <button
                type="button"
                onClick={() => setCurrentStep(2)}
                className="text-xs text-rose-600 font-bold bg-rose-50 px-2.5 py-1 rounded-lg"
              >
                ⬅️ ब्राइटनेस बदलें
              </button>
            </div>

            {/* Target KB Slider (10 KB to 500 KB) */}
            <div className="space-y-3">
              <div className="flex justify-between items-center">
                <label className="text-xs font-bold text-slate-800 uppercase tracking-wider">
                  टारगेट साइज़ (KB)
                </label>
                <div className="flex items-center gap-1.5 bg-rose-50 px-3 py-1 rounded-xl border border-rose-200">
                  <input
                    type="number"
                    min="10"
                    max="500"
                    value={targetKb}
                    onChange={(e) => setTargetKb(Math.max(10, Math.min(500, Number(e.target.value))))}
                    className="w-14 bg-transparent text-right font-mono font-black text-rose-600 text-sm focus:outline-none"
                  />
                  <span className="text-xs font-bold text-rose-600">KB</span>
                </div>
              </div>

              <input
                type="range"
                min="10"
                max="500"
                step="5"
                value={targetKb}
                onChange={(e) => setTargetKb(Number(e.target.value))}
                className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-rose-600"
              />
              <div className="flex justify-between text-[10px] text-slate-400">
                <span>10 KB</span>
                <span>150 KB</span>
                <span>300 KB</span>
                <span>500 KB</span>
              </div>
            </div>

            {/* Layout Options */}
            <div className="space-y-2">
              <label className="text-xs font-bold text-slate-700 block">प्रिंट लेआउट:</label>
              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={() => setLayoutMode("side-by-side")}
                  className={`p-3 rounded-xl border text-center transition ${
                    layoutMode === "side-by-side"
                      ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                      : "bg-white text-slate-700 border-slate-200"
                  }`}
                >
                  <span className="text-xs font-bold block">साइड-बाय-साइड</span>
                  <span className={`text-[9px] ${layoutMode === "side-by-side" ? "text-rose-100" : "text-slate-400"}`}>
                    अलग-अलग काटने के लिए
                  </span>
                </button>
                <button
                  type="button"
                  onClick={() => setLayoutMode("stack-fold")}
                  className={`p-3 rounded-xl border text-center transition ${
                    layoutMode === "stack-fold"
                      ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                      : "bg-white text-slate-700 border-slate-200"
                  }`}
                >
                  <span className="text-xs font-bold block">सेंटर-फ़ोल्ड</span>
                  <span className={`text-[9px] ${layoutMode === "stack-fold" ? "text-rose-100" : "text-slate-400"}`}>
                    मोड़कर लेमिनेशन के लिए
                  </span>
                </button>
              </div>
            </div>

            {/* Action */}
            <button
              type="button"
              onClick={generateFinalSheet}
              disabled={isProcessing}
              className="w-full py-4 bg-rose-600 hover:bg-rose-700 disabled:opacity-50 text-white font-bold rounded-2xl text-sm shadow-md transition flex items-center justify-center gap-2"
            >
              {isProcessing ? "300 DPI शीट तैयार हो रही है..." : `🖨️ A4 प्रिंट शीट बनाएँ (${targetKb} KB लक्ष्य)`}
            </button>

            {/* Download Results */}
            {(downloadJpgUrl || downloadPdfUrl) && (
              <div className="pt-3 border-t border-slate-100 space-y-3">
                <div className="flex justify-between items-center">
                  <span className="text-xs font-bold text-slate-700">तैयार फ़ाइल:</span>
                  <span className="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200 text-xs font-black">
                    {outputSizeKb} KB
                  </span>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {downloadPdfUrl && (
                    <a
                      href={downloadPdfUrl}
                      download={`PVC-Card-A4-${outputSizeKb}kb.pdf`}
                      className="py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-center text-xs shadow-sm transition flex items-center justify-center gap-1.5"
                    >
                      📄 A4 PDF (100% प्रिंट स्केल)
                    </a>
                  )}
                  {downloadJpgUrl && (
                    <a
                      href={downloadJpgUrl}
                      download={`PVC-Card-Sheet-${outputSizeKb}kb.jpg`}
                      className="py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-center text-xs shadow-sm transition flex items-center justify-center gap-1.5"
                    >
                      🖼️ Ultra HD JPG
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        )}

      </div>
    </div>
  );
}
