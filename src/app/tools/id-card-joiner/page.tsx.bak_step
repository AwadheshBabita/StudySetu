"use client";
"use client";

import { useState, useRef, ChangeEvent } from "react";
import { PDFDocument } from "pdf-lib";

interface CropRect {
  x: number;
  y: number;
  w: number;
  h: number;
}

export default function IdCardCropperPage() {
  const [frontImgSrc, setFrontImgSrc] = useState<string | null>(null);
  const [backImgSrc, setBackImgSrc] = useState<string | null>(null);

  const [frontRotation, setFrontRotation] = useState<number>(0);
  const [backRotation, setBackRotation] = useState<number>(0);

  const [activeTab, setActiveTab] = useState<"front" | "back">("front");
  const [layoutMode, setLayoutMode] = useState<"side-by-side" | "stack-fold">("side-by-side");

  // Target KB Slider: 10 KB to 500 KB (Default 300 KB for crystal HD)
  const [targetKb, setTargetKb] = useState<number>(300);

  // Crop boxes (relative to natural image size)
  const [frontCrop, setFrontCrop] = useState<CropRect | null>(null);
  const [backCrop, setBackCrop] = useState<CropRect | null>(null);

  // Active interaction for magnifying lens
  const [isDraggingHandle, setIsDraggingHandle] = useState<string | null>(null);
  const [magnifierData, setMagnifierData] = useState<{
    visible: boolean;
    x: number;
    y: number;
    cornerName: string;
  }>({ visible: false, x: 0, y: 0, cornerName: "" });

  const [isProcessing, setIsProcessing] = useState<boolean>(false);
  const [progressText, setProgressText] = useState<string>("");
  const [downloadJpgUrl, setDownloadJpgUrl] = useState<string | null>(null);
  const [downloadPdfUrl, setDownloadPdfUrl] = useState<string | null>(null);
  const [outputSizeKb, setOutputSizeKb] = useState<number | null>(null);

  const imageRef = useRef<HTMLImageElement | null>(null);
  const containerRef = useRef<HTMLDivElement | null>(null);
  const magnifierCanvasRef = useRef<HTMLCanvasElement | null>(null);

  // Standard PVC Ratio: 85.6mm / 54mm = 1.585
  const CARD_RATIO = 85.6 / 54.0;

  const handleUpload = (e: ChangeEvent<HTMLInputElement>, side: "front" | "back") => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      const src = reader.result as string;
      if (side === "front") {
        setFrontImgSrc(src);
        setFrontRotation(0);
        setFrontCrop(null);
        setActiveTab("front");
      } else {
        setBackImgSrc(src);
        setBackRotation(0);
        setBackCrop(null);
        setActiveTab("back");
      }
      setDownloadJpgUrl(null);
      setDownloadPdfUrl(null);
      setOutputSizeKb(null);
    };
    reader.readAsDataURL(file);
  };

  const rotateImage = (side: "front" | "back") => {
    if (side === "front") {
      setFrontRotation((prev) => (prev + 90) % 360);
      setFrontCrop(null);
    } else {
      setBackRotation((prev) => (prev + 90) % 360);
      setBackCrop(null);
    }
  };

  const onImageLoad = () => {
    if (!imageRef.current) return;
    const img = imageRef.current;
    const nw = img.naturalWidth;
    const nh = img.naturalHeight;

    let initW = nw * 0.85;
    let initH = initW / CARD_RATIO;
    if (initH > nh * 0.85) {
      initH = nh * 0.85;
      initW = initH * CARD_RATIO;
    }
    const initX = (nw - initW) / 2;
    const initY = (nh - initH) / 2;

    const initialCrop: CropRect = { x: initX, y: initY, w: initW, h: initH };
    if (activeTab === "front" && !frontCrop) setFrontCrop(initialCrop);
    if (activeTab === "back" && !backCrop) setBackCrop(initialCrop);
  };

  const currentCrop = activeTab === "front" ? frontCrop : backCrop;
  const setCurrentCrop = (c: CropRect) => {
    if (activeTab === "front") setFrontCrop(c);
    else setBackCrop(c);
  };

  // Magnifying Glass Render (Draw zoomed area around dragged corner)
  const drawMagnifier = (focusX: number, focusY: number, touchX: number, touchY: number, label: string) => {
    const mCanvas = magnifierCanvasRef.current;
    const img = imageRef.current;
    if (!mCanvas || !img) return;

    setMagnifierData({
      visible: true,
      x: Math.max(70, Math.min(window.innerWidth - 70, touchX)),
      y: Math.max(90, touchY - 80),
      cornerName: label,
    });

    const ctx = mCanvas.getContext("2d");
    if (!ctx) return;

    mCanvas.width = 130;
    mCanvas.height = 130;
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.clearRect(0, 0, 130, 130);

    // 3.0x Ultra Clear Zoom
    const zoom = 3.0;
    const sW = 130 / zoom;
    const sH = 130 / zoom;
    const sX = focusX - sW / 2;
    const sY = focusY - sH / 2;

    ctx.drawImage(img, sX, sY, sW, sH, 0, 0, 130, 130);

    // Crosshair target
    ctx.strokeStyle = "#e11d48";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(65, 40);
    ctx.lineTo(65, 90);
    ctx.moveTo(40, 65);
    ctx.lineTo(90, 65);
    ctx.stroke();

    // Center precise point
    ctx.fillStyle = "#e11d48";
    ctx.beginPath();
    ctx.arc(65, 65, 3, 0, Math.PI * 2);
    ctx.fill();
  };

  const handleStart = (handle: string, clientX: number, clientY: number) => {
    setIsDraggingHandle(handle);
  };

  const handleMove = (clientX: number, clientY: number) => {
    if (!isDraggingHandle || !currentCrop || !imageRef.current || !containerRef.current) return;

    const img = imageRef.current;
    const rect = img.getBoundingClientRect();
    const scaleX = img.naturalWidth / rect.width;
    const scaleY = img.naturalHeight / rect.height;

    const curImgX = Math.max(0, Math.min(img.naturalWidth, (clientX - rect.left) * scaleX));
    const curImgY = Math.max(0, Math.min(img.naturalHeight, (clientY - rect.top) * scaleY));

    let { x, y, w, h } = currentCrop;

    if (isDraggingHandle === "move") {
      const halfW = w / 2;
      const halfH = h / 2;
      x = Math.max(0, Math.min(img.naturalWidth - w, curImgX - halfW));
      y = Math.max(0, Math.min(img.naturalHeight - h, curImgY - halfH));
    } else if (isDraggingHandle === "br") {
      // Bottom-Right Corner
      const targetW = Math.max(80, curImgX - x);
      w = Math.min(img.naturalWidth - x, targetW);
      h = w / CARD_RATIO;
      if (y + h > img.naturalHeight) {
        h = img.naturalHeight - y;
        w = h * CARD_RATIO;
      }
      drawMagnifier(x + w, y + h, clientX, clientY, "निचला दायाँ कोना");
    } else if (isDraggingHandle === "tl") {
      // Top-Left Corner
      const right = x + w;
      const bottom = y + h;
      w = Math.max(80, right - curImgX);
      h = w / CARD_RATIO;
      x = right - w;
      y = bottom - h;
      if (x < 0) {
        x = 0;
        w = right;
        h = w / CARD_RATIO;
        y = bottom - h;
      }
      if (y < 0) {
        y = 0;
        h = bottom;
        w = h * CARD_RATIO;
        x = right - w;
      }
      drawMagnifier(x, y, clientX, clientY, "ऊपरी बायाँ कोना");
    } else if (isDraggingHandle === "tr") {
      // Top-Right Corner
      const bottom = y + h;
      w = Math.max(80, curImgX - x);
      h = w / CARD_RATIO;
      y = bottom - h;
      if (y < 0) {
        y = 0;
        h = bottom;
        w = h * CARD_RATIO;
      }
      if (x + w > img.naturalWidth) {
        w = img.naturalWidth - x;
        h = w / CARD_RATIO;
        y = bottom - h;
      }
      drawMagnifier(x + w, y, clientX, clientY, "ऊपरी दायाँ कोना");
    } else if (isDraggingHandle === "bl") {
      // Bottom-Left Corner
      const right = x + w;
      w = Math.max(80, right - curImgX);
      h = w / CARD_RATIO;
      x = right - w;
      if (x < 0) {
        x = 0;
        w = right;
        h = w / CARD_RATIO;
      }
      if (y + h > img.naturalHeight) {
        h = img.naturalHeight - y;
        w = h * CARD_RATIO;
        x = right - w;
      }
      drawMagnifier(x, y + h, clientX, clientY, "निचला बायाँ कोना");
    }

    setCurrentCrop({ x, y, w, h });
  };

  const handleEnd = () => {
    setIsDraggingHandle(null);
    setMagnifierData({ visible: false, x: 0, y: 0, cornerName: "" });
  };

  // Master Generator: Exact 10 KB - 500 KB lock with 300 DPI Canvas
  const generateUltraHdSheet = async () => {
    if (!frontImgSrc || !backImgSrc) {
      alert("कृपया दोनों (Front और Back) साइड अपलोड करें!");
      return;
    }
    setIsProcessing(true);
    setProgressText("300 DPI कार्ड रेंडर हो रहा है...");

    try {
      const getCroppedCanvas = async (src: string, rot: number, crop: CropRect | null): Promise<HTMLCanvasElement> => {
        return new Promise((resolve) => {
          const img = new Image();
          img.crossOrigin = "anonymous";
          img.onload = () => {
            const rCanvas = document.createElement("canvas");
            const is90 = rot === 90 || rot === 270;
            rCanvas.width = is90 ? img.height : img.width;
            rCanvas.height = is90 ? img.width : img.height;
            const rCtx = rCanvas.getContext("2d")!;
            rCtx.translate(rCanvas.width / 2, rCanvas.height / 2);
            rCtx.rotate((rot * Math.PI) / 180);
            rCtx.drawImage(img, -img.width / 2, -img.height / 2);

            const finalCrop = crop || { x: 0, y: 0, w: rCanvas.width, h: rCanvas.width / CARD_RATIO };
            const cCanvas = document.createElement("canvas");
            cCanvas.width = 1011; // 300 DPI standard 85.6mm
            cCanvas.height = 638; // 300 DPI standard 54mm
            const cCtx = cCanvas.getContext("2d")!;
            cCtx.imageSmoothingEnabled = true;
            cCtx.imageSmoothingQuality = "high";
            cCtx.drawImage(
              rCanvas,
              finalCrop.x,
              finalCrop.y,
              finalCrop.w,
              finalCrop.h,
              0,
              0,
              1011,
              638
            );
            resolve(cCanvas);
          };
          img.src = src;
        });
      };

      const [frontCanvas, backCanvas] = await Promise.all([
        getCroppedCanvas(frontImgSrc, frontRotation, frontCrop),
        getCroppedCanvas(backImgSrc, backRotation, backCrop),
      ]);

      // A4 Master Canvas: 2480 x 3508 pixels
      const a4Canvas = document.createElement("canvas");
      a4Canvas.width = 2480;
      a4Canvas.height = 3508;
      const ctx = a4Canvas.getContext("2d")!;
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, 2480, 3508);

      const cardW = 1011;
      const cardH = 638;
      const cornerRadius = 24;

      const drawSmartCard = (cardCanvas: HTMLCanvasElement, x: number, y: number) => {
        ctx.save();
        ctx.beginPath();
        ctx.roundRect(x, y, cardW, cardH, cornerRadius);
        ctx.clip();
        ctx.drawImage(cardCanvas, x, y, cardW, cardH);
        ctx.restore();

        // 1px Ultra-light Cutting Guideline
        ctx.save();
        ctx.strokeStyle = "#cbd5e1";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.roundRect(x, y, cardW, cardH, cornerRadius);
        ctx.stroke();
        ctx.restore();
      };

      if (layoutMode === "side-by-side") {
        const gap = 120;
        const totalW = cardW * 2 + gap;
        const startX = (2480 - totalW) / 2;
        const startY = 320;
        drawSmartCard(frontCanvas, startX, startY);
        drawSmartCard(backCanvas, startX + cardW + gap, startY);

        ctx.save();
        ctx.strokeStyle = "#e2e8f0";
        ctx.setLineDash([12, 12]);
        ctx.beginPath();
        ctx.moveTo(startX + cardW + gap / 2, startY - 40);
        ctx.lineTo(startX + cardW + gap / 2, startY + cardH + 40);
        ctx.stroke();
        ctx.restore();
      } else {
        const startX = (2480 - cardW) / 2;
        const startY = 320;
        drawSmartCard(frontCanvas, startX, startY);
        drawSmartCard(backCanvas, startX, startY + cardH + 10);

        ctx.save();
        ctx.strokeStyle = "#94a3b8";
        ctx.setLineDash([8, 8]);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(startX - 30, startY + cardH + 5);
        ctx.lineTo(startX + cardW + 30, startY + cardH + 5);
        ctx.stroke();
        ctx.restore();
      }

      // TARGET KB SEARCH LOOP (10 KB - 500 KB EXACT LOCK)
      setProgressText(`टारगेट ${targetKb} KB में अनुकूलित हो रहा है...`);
      const targetBytes = targetKb * 1024;
      let qLow = 0.05;
      let qHigh = 0.98;
      let bestBlob: Blob | null = null;

      // Iterative Binary Search for exact byte size match
      for (let iter = 0; iter < 6; iter++) {
        const qMid = (qLow + qHigh) / 2;
        const blob: Blob = await new Promise((res) => {
          a4Canvas.toBlob((b) => res(b!), "image/jpeg", qMid);
        });

        if (blob.size <= targetBytes) {
          bestBlob = blob;
          qLow = qMid;
        } else {
          qHigh = qMid;
        }
      }

      // Safe fallback if target is ultra-low (10-30 KB)
      if (!bestBlob) {
        bestBlob = await new Promise((res) => {
          a4Canvas.toBlob((b) => res(b!), "image/jpeg", 0.08);
        });
      }

      const calculatedKb = Math.round(bestBlob!.size / 1024);
      setOutputSizeKb(calculatedKb);

      if (downloadJpgUrl) URL.revokeObjectURL(downloadJpgUrl);
      setDownloadJpgUrl(URL.createObjectURL(bestBlob!));

      // Embed into Print-Ready A4 PDF
      setProgressText("A4 PDF बन रही है...");
      const pdfDoc = await PDFDocument.create();
      const jpgBytes = await bestBlob!.arrayBuffer();
      const embeddedJpg = await pdfDoc.embedJpg(jpgBytes);
      const pdfPage = pdfDoc.addPage([595.28, 841.89]);
      pdfPage.drawImage(embeddedJpg, {
        x: 0,
        y: 0,
        width: 595.28,
        height: 841.89,
      });

      const pdfBytes = await pdfDoc.save({ useObjectStreams: true });
      const pdfBlob = new Blob([pdfBytes], { type: "application/pdf" });
      if (downloadPdfUrl) URL.revokeObjectURL(downloadPdfUrl);
      setDownloadPdfUrl(URL.createObjectURL(pdfBlob));

    } catch (err) {
      console.error(err);
      alert("प्रिंट शीट तैयार करने में समस्या आई।");
    } finally {
      setIsProcessing(false);
      setProgressText("");
    }
  };

  return (
    <div className="min-h-screen bg-slate-50/50 text-slate-800 py-8 px-4 sm:px-6 select-none">
      <div className="max-w-xl mx-auto space-y-6">
        
        {/* Header */}
        <div className="text-center space-y-2">
          <span className="inline-flex items-center gap-1.5 bg-rose-50 text-rose-700 text-xs px-3 py-1 rounded-full font-bold border border-rose-100">
            <span className="w-2 h-2 rounded-full bg-rose-500"></span>
            300 DPI Ultra HD • सटीक 85.6mm x 54mm PVC साइज़
          </span>
          <h1 className="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            ID Card / PVC Print Cropper
          </h1>
          <p className="text-xs sm:text-sm text-slate-500">
            आधार, वोटर व पैन कार्ड को मैग्निफाइंग लेंस से सटीक चुनें और मनपसंद KB में 100% प्रिंट शीट निकालें
          </p>
        </div>

        {/* Upload Dual Box */}
        <div className="grid grid-cols-2 gap-3">
          <div className="bg-white p-3 rounded-2xl border border-slate-200 shadow-xs space-y-2 text-center">
            <div className="flex justify-between items-center">
              <span className="text-xs font-bold text-slate-700">1. कार्ड फ़्रंट</span>
              {frontImgSrc && (
                <button
                  type="button"
                  onClick={() => rotateImage("front")}
                  className="text-[11px] font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 px-2 py-0.5 rounded-md transition"
                >
                  🔄 90° घुमाएँ
                </button>
              )}
            </div>
            <label className="block border-2 border-dashed border-slate-200 hover:border-rose-400 rounded-xl p-3 cursor-pointer bg-slate-50/50 transition">
              <input
                type="file"
                accept="image/*"
                onChange={(e) => handleUpload(e, "front")}
                className="sr-only"
              />
              <span className="text-xs font-semibold text-slate-600 block truncate">
                {frontImgSrc ? "✅ फ़्रंट अपलोड" : "➕ फ़्रंट अपलोड करें"}
              </span>
            </label>
          </div>

          <div className="bg-white p-3 rounded-2xl border border-slate-200 shadow-xs space-y-2 text-center">
            <div className="flex justify-between items-center">
              <span className="text-xs font-bold text-slate-700">2. कार्ड बैक</span>
              {backImgSrc && (
                <button
                  type="button"
                  onClick={() => rotateImage("back")}
                  className="text-[11px] font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 px-2 py-0.5 rounded-md transition"
                >
                  🔄 90° घुमाएँ
                </button>
              )}
            </div>
            <label className="block border-2 border-dashed border-slate-200 hover:border-rose-400 rounded-xl p-3 cursor-pointer bg-slate-50/50 transition">
              <input
                type="file"
                accept="image/*"
                onChange={(e) => handleUpload(e, "back")}
                className="sr-only"
              />
              <span className="text-xs font-semibold text-slate-600 block truncate">
                {backImgSrc ? "✅ बैक अपलोड" : "➕ बैक अपलोड करें"}
              </span>
            </label>
          </div>
        </div>

        {/* Tab Switcher */}
        {(frontImgSrc || backImgSrc) && (
          <div className="flex gap-2">
            <button
              type="button"
              onClick={() => setActiveTab("front")}
              disabled={!frontImgSrc}
              className={`flex-1 py-2.5 text-xs font-bold rounded-xl border transition ${
                activeTab === "front"
                  ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                  : "bg-white text-slate-600 border-slate-200 disabled:opacity-40"
              }`}
            >
              फ़्रंट (Front) सलेक्शन सेट करें
            </button>
            <button
              type="button"
              onClick={() => setActiveTab("back")}
              disabled={!backImgSrc}
              className={`flex-1 py-2.5 text-xs font-bold rounded-xl border transition ${
                activeTab === "back"
                  ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                  : "bg-white text-slate-600 border-slate-200 disabled:opacity-40"
              }`}
            >
              बैक (Back) सलेक्शन सेट करें
            </button>
          </div>
        )}

        {/* Cropper Canvas Area with Magnifying Lens */}
        {(activeTab === "front" ? frontImgSrc : backImgSrc) && (
          <div className="bg-white p-4 rounded-3xl border border-slate-200 shadow-sm space-y-3">
            <div className="flex justify-between items-center text-xs text-slate-500 font-medium">
              <span>🔍 चारों कोनों को खींचकर कार्ड पर सटीक फ़िट करें</span>
              <span className="text-rose-600 font-bold">मैग्नीफायर लेंस एक्टिव</span>
            </div>

            <div
              ref={containerRef}
              className="relative overflow-hidden rounded-2xl bg-slate-950 flex items-center justify-center min-h-[260px] touch-none"
              onMouseMove={(e) => handleMove(e.clientX, e.clientY)}
              onMouseUp={handleEnd}
              onTouchMove={(e) => handleMove(e.touches[0].clientX, e.touches[0].clientY)}
              onTouchEnd={handleEnd}
            >
              <img
                ref={imageRef}
                src={activeTab === "front" ? frontImgSrc! : backImgSrc!}
                alt="Crop Target"
                onLoad={onImageLoad}
                style={{
                  transform: `rotate(${activeTab === "front" ? frontRotation : backRotation}deg)`,
                }}
                className="max-h-[380px] w-auto object-contain pointer-events-none transition-transform"
              />

              {/* Crop Box Overlay with 4 Corner Handles - NO TL/BR TEXT */}
              {currentCrop && imageRef.current && (() => {
                const img = imageRef.current;
                const rect = img.getBoundingClientRect();
                const containerRect = containerRef.current?.getBoundingClientRect();
                if (!containerRect) return null;

                const offsetX = rect.left - containerRect.left;
                const offsetY = rect.top - containerRect.top;
                const scaleX = rect.width / img.naturalWidth;
                const scaleY = rect.height / img.naturalHeight;

                const boxLeft = offsetX + currentCrop.x * scaleX;
                const boxTop = offsetY + currentCrop.y * scaleY;
                const boxWidth = currentCrop.w * scaleX;
                const boxHeight = currentCrop.h * scaleY;

                return (
                  <div
                    style={{
                      left: `${boxLeft}px`,
                      top: `${boxTop}px`,
                      width: `${boxWidth}px`,
                      height: `${boxHeight}px`,
                    }}
                    className="absolute border-2 border-rose-500 bg-rose-500/10 cursor-move shadow-[0_0_0_9999px_rgba(0,0,0,0.6)] rounded-lg"
                    onMouseDown={(e) => {
                      e.stopPropagation();
                      handleStart("move", e.clientX, e.clientY);
                    }}
                    onTouchStart={(e) => {
                      e.stopPropagation();
                      handleStart("move", e.touches[0].clientX, e.touches[0].clientY);
                    }}
                  >
                    {/* Top-Left Corner Handle */}
                    <div
                      onMouseDown={(e) => {
                        e.stopPropagation();
                        handleStart("tl", e.clientX, e.clientY);
                      }}
                      onTouchStart={(e) => {
                        e.stopPropagation();
                        handleStart("tl", e.touches[0].clientX, e.touches[0].clientY);
                      }}
                      className="absolute -top-3.5 -left-3.5 w-7 h-7 rounded-full bg-white border-2 border-rose-600 shadow-lg cursor-nwse-resize active:scale-125 transition-transform"
                    />

                    {/* Top-Right Corner Handle */}
                    <div
                      onMouseDown={(e) => {
                        e.stopPropagation();
                        handleStart("tr", e.clientX, e.clientY);
                      }}
                      onTouchStart={(e) => {
                        e.stopPropagation();
                        handleStart("tr", e.touches[0].clientX, e.touches[0].clientY);
                      }}
                      className="absolute -top-3.5 -right-3.5 w-7 h-7 rounded-full bg-white border-2 border-rose-600 shadow-lg cursor-nesw-resize active:scale-125 transition-transform"
                    />

                    {/* Bottom-Left Corner Handle */}
                    <div
                      onMouseDown={(e) => {
                        e.stopPropagation();
                        handleStart("bl", e.clientX, e.clientY);
                      }}
                      onTouchStart={(e) => {
                        e.stopPropagation();
                        handleStart("bl", e.touches[0].clientX, e.touches[0].clientY);
                      }}
                      className="absolute -bottom-3.5 -left-3.5 w-7 h-7 rounded-full bg-white border-2 border-rose-600 shadow-lg cursor-nesw-resize active:scale-125 transition-transform"
                    />

                    {/* Bottom-Right Corner Handle */}
                    <div
                      onMouseDown={(e) => {
                        e.stopPropagation();
                        handleStart("br", e.clientX, e.clientY);
                      }}
                      onTouchStart={(e) => {
                        e.stopPropagation();
                        handleStart("br", e.touches[0].clientX, e.touches[0].clientY);
                      }}
                      className="absolute -bottom-3.5 -right-3.5 w-7 h-7 rounded-full bg-white border-2 border-rose-600 shadow-lg cursor-nwse-resize active:scale-125 transition-transform"
                    />
                  </div>
                );
              })()}

              {/* Floating Magnifying Lens Popup */}
              <div
                style={{
                  display: magnifierData.visible ? "block" : "none",
                  left: `${magnifierData.x - 65}px`,
                  top: `${magnifierData.y - 65}px`,
                }}
                className="fixed pointer-events-none z-50 rounded-full border-4 border-rose-500 bg-white shadow-2xl overflow-hidden"
              >
                <canvas ref={magnifierCanvasRef} className="w-[130px] h-[130px]" />
                <div className="absolute bottom-1 w-full text-center text-[9px] font-bold text-rose-700 bg-white/80 py-0.5">
                  {magnifierData.cornerName}
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Target KB Slider (10 KB to 500 KB) */}
        <div className="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm space-y-4">
          <div className="flex justify-between items-center">
            <div>
              <label className="text-xs font-bold text-slate-800 uppercase tracking-wider block">
                टारगेट फ़ाइल साइज़ (10 KB - 500 KB)
              </label>
              <span className="text-[11px] text-slate-400">
                500 KB पर 300 DPI अल्ट्रा क्लियर HD प्रिंट
              </span>
            </div>

            {/* Direct KB Type Input */}
            <div className="flex items-center gap-1.5 bg-rose-50 px-3 py-1 rounded-xl border border-rose-200">
              <input
                type="number"
                min="10"
                max="500"
                value={targetKb}
                onChange={(e) => setTargetKb(Math.max(10, Math.min(500, Number(e.target.value))))}
                className="w-14 bg-transparent text-right font-mono font-black text-rose-600 text-sm focus:outline-none"
              />
              <span className="text-xs font-bold text-rose-600">KB</span>
            </div>
          </div>

          {/* Quick Presets */}
          <div className="grid grid-cols-4 gap-2">
            {[
              { label: "50 KB", desc: "छोटा साइज़", kb: 50 },
              { label: "100 KB", desc: "सरकारी पोर्टल", kb: 100 },
              { label: "300 KB", desc: "मानक प्रिंट", kb: 300 },
              { label: "500 KB", desc: "अल्ट्रा HD", kb: 500 },
            ].map((p) => (
              <button
                key={p.kb}
                type="button"
                onClick={() => setTargetKb(p.kb)}
                className={`py-2 px-1 text-center rounded-xl border transition ${
                  targetKb === p.kb
                    ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                    : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50"
                }`}
              >
                <div className="text-xs font-extrabold">{p.label}</div>
                <div className={`text-[9px] ${targetKb === p.kb ? "text-rose-100" : "text-slate-400"}`}>
                  {p.desc}
                </div>
              </button>
            ))}
          </div>

          {/* Range Slider 10 - 500 KB */}
          <div className="space-y-1 pt-1">
            <input
              type="range"
              min="10"
              max="500"
              step="5"
              value={targetKb}
              onChange={(e) => setTargetKb(Number(e.target.value))}
              className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-rose-600"
            />
            <div className="flex justify-between text-[10px] text-slate-400 font-medium">
              <span>10 KB</span>
              <span>150 KB</span>
              <span>300 KB</span>
              <span>500 KB</span>
            </div>
          </div>

          {/* Layout Options */}
          <div className="pt-2 border-t border-slate-100 space-y-2">
            <label className="block text-xs font-bold text-slate-700">
              प्रिंटिंग लेआउट:
            </label>
            <div className="grid grid-cols-2 gap-2">
              <button
                type="button"
                onClick={() => setLayoutMode("side-by-side")}
                className={`p-2.5 rounded-xl border text-center transition ${
                  layoutMode === "side-by-side"
                    ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                    : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50"
                }`}
              >
                <span className="text-xs font-bold block">साइड-बाय-साइड</span>
                <span className={`text-[9px] ${layoutMode === "side-by-side" ? "text-rose-100" : "text-slate-400"}`}>
                  अलग-अलग चिपकाने हेतु
                </span>
              </button>
              <button
                type="button"
                onClick={() => setLayoutMode("stack-fold")}
                className={`p-2.5 rounded-xl border text-center transition ${
                  layoutMode === "stack-fold"
                    ? "bg-rose-600 text-white border-rose-600 shadow-sm"
                    : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50"
                }`}
              >
                <span className="text-xs font-bold block">सेंटर-फ़ोल्ड</span>
                <span className={`text-[9px] ${layoutMode === "stack-fold" ? "text-rose-100" : "text-slate-400"}`}>
                  बीच से मोड़कर लेमिनेशन हेतु
                </span>
              </button>
            </div>
          </div>

          {/* Generate Button */}
          <button
            type="button"
            onClick={generateUltraHdSheet}
            disabled={!frontImgSrc || !backImgSrc || isProcessing}
            className="w-full py-4 bg-rose-600 hover:bg-rose-700 disabled:opacity-50 text-white font-bold rounded-2xl text-sm shadow-md transition flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]"
          >
            {isProcessing ? (
              <span className="flex items-center gap-2">
                <span className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                <span>{progressText || "300 DPI शीट तैयार हो रही है..."}</span>
              </span>
            ) : (
              <span>🖨️ A4 शीट तैयार करें ({targetKb} KB लक्ष्य)</span>
            )}
          </button>
        </div>

        {/* Result Card */}
        {(downloadJpgUrl || downloadPdfUrl) && (
          <div className="bg-white rounded-3xl p-5 sm:p-6 border border-emerald-200 shadow-sm space-y-4">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="font-bold text-slate-900 text-sm sm:text-base">
                  प्रिंट शीट तैयार है!
                </h3>
                <p className="text-xs text-slate-500">
                  300 DPI Ultra HD • सटीक 85.6mm x 54mm PVC साइज़
                </p>
              </div>
              <span className="text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200 font-mono text-sm font-black">
                {outputSizeKb} KB
              </span>
            </div>

            <div className="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {downloadPdfUrl && (
                <a
                  href={downloadPdfUrl}
                  download={`PVC-Card-A4-${outputSizeKb}kb.pdf`}
                  className="py-3.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-center text-sm shadow-sm transition flex items-center justify-center gap-2"
                >
                  📄 डाउनलोड A4 PDF (सटीक प्रिंट स्केल)
                </a>
              )}
              {downloadJpgUrl && (
                <a
                  href={downloadJpgUrl}
                  download={`PVC-Card-Sheet-${outputSizeKb}kb.jpg`}
                  className="py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-center text-sm shadow-sm transition flex items-center justify-center gap-2"
                >
                  🖼️ डाउनलोड Ultra HD JPG ({outputSizeKb} KB)
                </a>
              )}
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
