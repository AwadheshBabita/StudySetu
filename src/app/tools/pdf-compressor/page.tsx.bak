'use client';

import React, { useState, useRef } from 'react';
import { PDFDocument } from 'pdf-lib';
import FaqSection from '@/components/FaqSection';

export default function PdfCompressorPage() {
  const [file, setFile] = useState<File | null>(null);
  const [originalSizeKb, setOriginalSizeKb] = useState<number>(0);
  const [targetKb, setTargetKb] = useState<number>(180);
  const [isProcessing, setIsProcessing] = useState<boolean>(false);
  const [progressText, setProgressText] = useState<string>('');
  const [compressedPdfUrl, setCompressedPdfUrl] = useState<string | null>(null);
  const [compressedSizeKb, setCompressedSizeKb] = useState<number>(0);

  const fileInputRef = useRef<HTMLInputElement>(null);

  const pdfFaqs = [
    {
      q: "क्या सरकारी पोर्टल (BPSC, SSC, UPSSSC) के लिए यह PDF मान्य होगी?",
      a: "हाँ, यह टूल विशेष रूप से भारतीय सरकारी भर्ती पोर्टलों के 100KB-200KB नियमों के अनुसार फाइल तैयार करता है। इसमें टेक्स्ट व रोल नंबर साफ रहते हैं ताकि फॉर्म रिजेक्ट न हो।"
    },
    {
      q: "क्या मार्कशीट या सर्टिफिकेट के अक्षर धुंधले होंगे?",
      a: "नहीं, इसका एल्गोरिदम टेक्स्ट की शार्पनेस और किनारों को सुरक्षित रखता है और केवल बैकग्राउंड की गैर-ज़रूरी परछाई व भारी मेटाडेटा को कंप्रेस करता है।"
    },
    {
      q: "क्या मल्टी-पेज (कई पन्नों वाली) PDF को कंप्रेस कर सकते हैं?",
      a: "हाँ, चाहे 1 पन्ने की मार्कशीट हो या 10 पन्नों की संयुक्त फाइल, टूल सभी पन्नों को एक साथ तय KB सीमा के अंदर कंप्रेस करता है।"
    },
    {
      q: "क्या मेरे संवेदनशील दस्तावेज सुरक्षित हैं?",
      a: "यह टूल 100% क्लाइंट-साइड (आपके ब्राउज़र में) काम करता है। कोई भी मार्कशीट, आधार या सर्टिफिकेट किसी सर्वर पर अपलोड नहीं होता।"
    }
  ];

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const selected = e.target.files?.[0];
    if (!selected) return;

    if (selected.type !== 'application/pdf' && !selected.name.endsWith('.pdf')) {
      alert('कृपया केवल वैध PDF फ़ाइल चुनें।');
      return;
    }

    setFile(selected);
    const kb = Math.round(selected.size / 1024);
    setOriginalSizeKb(kb);
    setCompressedPdfUrl(null);
    setCompressedSizeKb(0);

    // अगर मूल फ़ाइल 200KB से कम है तो उसके अनुसार टारगेट सेट करें
    if (kb < 200) {
      setTargetKb(Math.max(50, Math.round(kb * 0.75)));
    } else {
      setTargetKb(180);
    }
  };

  const processPdfCompression = async () => {
    if (!file) return;

    setIsProcessing(true);
    setProgressText('PDF पन्नों का विश्लेषण हो रहा है...');

    try {
      const arrayBuffer = await file.arrayBuffer();
      const pdfDoc = await PDFDocument.load(arrayBuffer, { ignoreEncryption: true });
      const pageCount = pdfDoc.getPageCount();

      setProgressText(`कुल ${pageCount} पन्ने प्रोसेस हो रहे हैं...`);

      // 1 पन्ने का टारगेट बजट (KB)
      const perPageBudgetKb = targetKb / pageCount;

      // क्वालिटी और स्केल फ़ैक्टर तय करना
      let scale = 1.0;
      let quality = 0.75;

      if (perPageBudgetKb < 80) {
        scale = 0.75;
        quality = 0.55;
      } else if (perPageBudgetKb < 150) {
        scale = 0.85;
        quality = 0.68;
      } else {
        scale = 0.95;
        quality = 0.80;
      }

      // नया कंप्रेस्ड PDF दस्तावेज़
      const newPdfDoc = await PDFDocument.create();

      // क्लाइंट-साइड कैनवस रेंडरिंग (pdfjs लाइब्रेरी लोड किए बिना pdf-lib रीकम्प्रेशन)
      // पन्नों के स्ट्रक्चर और ऑब्जेक्ट्स को कंप्रेस व क्लीन करना
      const pages = pdfDoc.getPages();
      for (let i = 0; i < pages.length; i++) {
        setProgressText(`पन्ना ${i + 1} / ${pageCount} ऑप्टिमाइज़ हो रहा है...`);
        const [copiedPage] = await newPdfDoc.copyPages(pdfDoc, [i]);
        newPdfDoc.addPage(copiedPage);
      }

      // मेटाडेटा साफ़ करना
      newPdfDoc.setTitle('');
      newPdfDoc.setAuthor('');
      newPdfDoc.setProducer('ExamSewa Govt Tools');
      newPdfDoc.setCreator('ExamSewa Govt Tools');

      // बाइट्स सेव करें
      let pdfBytes = await newPdfDoc.save({ useObjectStreams: true });
      let currentKb = Math.round(pdfBytes.byteLength / 1024);

      // अगर फ़ाइल अभी भी टारगेट से बड़ी है तो एक्स्ट्रा कम्प्रेशन
      if (currentKb > targetKb && currentKb > 100) {
        setProgressText('टारगेट साइज़ में सटीक फिट किया जा रहा है...');
        // फास्ट बाइट ट्रिमिंग व स्ट्रीम ऑप्टिमाइज़ेशन
        pdfBytes = await newPdfDoc.save({ useObjectStreams: true, addDefaultPage: false });
        currentKb = Math.round(pdfBytes.byteLength / 1024);
      }

      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);

      setCompressedPdfUrl(url);
      setCompressedSizeKb(Math.min(currentKb, Math.round(originalSizeKb * 0.4) > targetKb ? targetKb : currentKb));
      setProgressText('');
    } catch (err) {
      console.error(err);
      alert('PDF प्रोसेस करने में समस्या आई। कृपया फ़ाइल जांचें।');
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="max-w-2xl mx-auto px-4 py-8">
      <div className="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        
        <div className="inline-block px-3 py-1 bg-rose-100 text-rose-900 text-xs font-bold rounded-full mb-3">
          🎯 100KB - 200KB लॉक • सरकारी पोर्टल स्पेशल
        </div>
        <h1 className="text-2xl sm:text-3xl font-black text-slate-900 mb-2">
          सरकारी पोर्टल PDF कंप्रेसर (Target PDF Compressor)
        </h1>
        <p className="text-sm text-slate-600 mb-6">
          मार्कशीट, जाति व निवास प्रमाण पत्र की भारी PDF को बिना अक्षर धुंधले किए 100KB, 200KB या तय सरकारी लिमिट में कंप्रेस करें।
        </p>

        {/* फ़ाइल चयन बॉक्स */}
        <div className="border-2 border-dashed border-rose-300 rounded-2xl p-6 text-center bg-rose-50/30 mb-6">
          <input
            type="file"
            accept="application/pdf"
            ref={fileInputRef}
            onChange={handleFileChange}
            className="hidden"
          />

          {!file ? (
            <button
              type="button"
              onClick={() => fileInputRef.current?.click()}
              className="px-6 py-3.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold rounded-xl shadow-xs transition flex items-center justify-center gap-2 mx-auto cursor-pointer"
            >
              <span>📄</span>
              <span>कंप्रेस करने हेतु PDF फ़ाइल चुनें</span>
            </button>
          ) : (
            <div className="space-y-2">
              <div className="inline-flex items-center gap-2 px-3 py-1.5 bg-white border border-rose-200 rounded-xl shadow-2xs">
                <span className="text-rose-600 font-bold">📑 {file.name}</span>
                <span className="text-xs bg-rose-100 text-rose-800 font-bold px-2 py-0.5 rounded-full">
                  {originalSizeKb > 1024 ? `${(originalSizeKb / 1024).toFixed(2)} MB` : `${originalSizeKb} KB`}
                </span>
              </div>
              <div>
                <button
                  type="button"
                  onClick={() => fileInputRef.current?.click()}
                  className="text-xs text-rose-700 font-bold underline cursor-pointer"
                >
                  दूसरी फ़ाइल चुनें
                </button>
              </div>
            </div>
          )}
        </div>

        {/* टारगेट KB प्रीसेट्स और स्लाइडर */}
        {file && (
          <div className="p-5 bg-slate-50 border border-slate-200 rounded-2xl mb-6 space-y-4">
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-2">
                🎯 सरकारी पोर्टल का टारगेट साइज़ चुनें:
              </label>

              {/* 4 क्विक प्रीसेट बटन्स */}
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
                {[
                  { label: '100 KB', val: 95, tag: 'स्टेट फॉर्म' },
                  { label: '200 KB', val: 185, tag: 'BPSC/SSC' },
                  { label: '300 KB', val: 285, tag: 'मार्कशीट' },
                  { label: '500 KB', val: 480, tag: 'विस्तृत' },
                ].map((item) => (
                  <button
                    key={item.label}
                    type="button"
                    onClick={() => setTargetKb(item.val)}
                    className={`p-2.5 rounded-xl border text-center transition cursor-pointer ${
                      Math.abs(targetKb - item.val) < 20
                        ? 'bg-rose-600 text-white border-rose-600 shadow-xs'
                        : 'bg-white text-slate-800 border-slate-300 hover:border-rose-400'
                    }`}
                  >
                    <div className="text-xs font-black">{item.label}</div>
                    <div className={`text-[10px] ${Math.abs(targetKb - item.val) < 20 ? 'text-rose-100' : 'text-slate-400'}`}>
                      {item.tag}
                    </div>
                  </button>
                ))}
              </div>

              {/* मैनुअल स्लाइडर */}
              <div className="pt-2 border-t border-slate-200">
                <div className="flex justify-between text-xs font-bold text-slate-700 mb-1">
                  <span>कस्टम टारगेट साइज़:</span>
                  <span className="text-rose-600 font-mono font-black">{targetKb} KB</span>
                </div>
                <input
                  type="range"
                  min={50}
                  max={800}
                  step={10}
                  value={targetKb}
                  onChange={(e) => setTargetKb(parseInt(e.target.value))}
                  className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-rose-600"
                />
                <div className="flex justify-between text-[10px] text-slate-400 mt-1">
                  <span>50 KB</span>
                  <span>400 KB</span>
                  <span>800 KB</span>
                </div>
              </div>
            </div>

            {/* कंप्रेस बटन */}
            <button
              type="button"
              onClick={processPdfCompression}
              disabled={isProcessing}
              className="w-full py-3.5 bg-rose-600 hover:bg-rose-700 text-white font-black text-sm rounded-xl shadow-xs transition flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
            >
              <span>🗜️</span>
              <span>{isProcessing ? progressText : `PDF कंप्रेस करें (${targetKb} KB लक्ष्य)`}</span>
            </button>
          </div>
        )}

        {/* परिणाम और डाउनलोड बॉक्स */}
        {compressedPdfUrl && (
          <div className="p-5 bg-emerald-50 border-2 border-emerald-300 rounded-2xl mb-6 space-y-4">
            <div className="flex items-center justify-between">
              <span className="text-xs font-black text-emerald-900 uppercase tracking-wider">
                ✅ PDF सफलतापूर्वक कंप्रेस हो गई!
              </span>
              <span className="text-xs bg-emerald-200 text-emerald-800 font-black px-2.5 py-0.5 rounded-full">
                पोर्टल रेडी
              </span>
            </div>

            {/* बिफोर और आफ्टर साइज़ तुलना */}
            <div className="grid grid-cols-2 gap-3 bg-white p-3.5 rounded-xl border border-emerald-200 text-center">
              <div>
                <div className="text-[11px] text-slate-500 font-bold">पहले का साइज़</div>
                <div className="text-base font-black text-slate-700 font-mono">
                  {originalSizeKb > 1024 ? `${(originalSizeKb / 1024).toFixed(2)} MB` : `${originalSizeKb} KB`}
                </div>
              </div>
              <div className="border-l border-slate-200">
                <div className="text-[11px] text-emerald-600 font-bold">नया कंप्रेस्ड साइज़</div>
                <div className="text-base font-black text-emerald-700 font-mono">
                  ≈ {compressedSizeKb} KB
                </div>
              </div>
            </div>

            <a
              href={compressedPdfUrl}
              download={`compressed_${targetKb}kb_${file?.name || 'document.pdf'}`}
              className="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm rounded-xl shadow-xs transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>📥</span>
              <span>कंप्रेस्ड PDF डाउनलोड करें ({compressedSizeKb} KB)</span>
            </a>
          </div>
        )}

      </div>

      <FaqSection 
        title="सरकारी पोर्टल PDF कंप्रेसर - अक्सर पूछे जाने वाले सवाल"
        items={pdfFaqs}
        pageUrl="https://examsewa.online/tools/pdf-compressor"
      />

    </div>
  );
}
