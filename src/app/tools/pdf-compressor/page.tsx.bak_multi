"use client";

import { useState, ChangeEvent } from "react";
import { PDFDocument } from "pdf-lib";

type CompressionMode = "recommended" | "high" | "small" | "target";

export default function PdfCompressorPage() {
  const [file, setFile] = useState<File | null>(null);
  const [mode, setMode] = useState<CompressionMode>("recommended");
  const [targetKb, setTargetKb] = useState<number>(300);
  const [isProcessing, setIsProcessing] = useState<boolean>(false);
  const [progressText, setProgressText] = useState<string>("");
  const [compressedPdfUrl, setCompressedPdfUrl] = useState<string | null>(null);
  const [compressedSizeKb, setCompressedSizeKb] = useState<number | null>(null);
  const [originalSizeKb, setOriginalSizeKb] = useState<number | null>(null);

  const handleFileChange = (e: ChangeEvent<HTMLInputElement>) => {
    const selected = e.target.files?.[0];
    if (!selected) return;
    if (selected.type !== "application/pdf" && !selected.name.toLowerCase().endsWith(".pdf")) {
      alert("कृपया केवल मान्य PDF फ़ाइल चुनें।");
      return;
    }
    setFile(selected);
    const origKb = Math.round(selected.size / 1024);
    setOriginalSizeKb(origKb);
    setCompressedPdfUrl(null);
    setCompressedSizeKb(null);

    // ऑटो सजेस्ट डिफ़ॉल्ट टारगेट KB अगर ओरिजिनल बहुत बड़ा है
    if (origKb > 600) {
      setTargetKb(Math.round(origKb * 0.4));
    } else {
      setTargetKb(Math.max(100, Math.round(origKb * 0.6)));
    }
  };

  const processPdfCompression = async () => {
    if (!file) return;
    setIsProcessing(true);
    setProgressText("PDF इंजन तैयार हो रहा है...");

    try {
      const pdfjs = await import("pdfjs-dist");
      // @ts-ignore
      pdfjs.GlobalWorkerOptions.workerSrc = `https://unpkg.com/pdfjs-dist@${pdfjs.version}/build/pdf.worker.min.mjs`;

      const arrayBuffer = await file.arrayBuffer();
      const loadingTask = pdfjs.getDocument({ data: arrayBuffer });
      const pdf = await loadingTask.promise;
      const numPages = pdf.numPages;

      const outPdfDoc = await PDFDocument.create();

      // मोड के अनुसार बेस स्केल और क्वालिटी का निर्धारण
      let baseScale = 2.0833; // 150 DPI मानक
      let baseQuality = 0.80; // iLovePDF मानक

      if (mode === "high") {
        baseScale = 2.5; // ~180-200 DPI
        baseQuality = 0.88;
      } else if (mode === "small") {
        baseScale = 1.6; // ~120 DPI
        baseQuality = 0.65;
      }

      // टारगेट साइज का पर-पेज बजट
      const overheadBytes = 1024 * (numPages + 2);
      const maxTotalBytes = targetKb * 1024;
      const perPageMaxBytes = Math.floor(Math.max(20 * 1024, (maxTotalBytes - overheadBytes) / numPages));

      for (let pageNum = 1; pageNum <= numPages; pageNum++) {
        setProgressText(`पेज ${pageNum} / ${numPages} को ऑप्टिमाइज़ किया जा रहा है...`);
        const page = await pdf.getPage(pageNum);
        const originalViewport = page.getViewport({ scale: 1.0 });

        let currentScale = baseScale;
        if (mode === "target") {
          currentScale = perPageMaxBytes < 45 * 1024 ? 1.4 : perPageMaxBytes < 90 * 1024 ? 1.8 : 2.0833;
        }

        const viewport = page.getViewport({ scale: currentScale });
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(viewport.width);
        canvas.height = Math.round(viewport.height);
        const ctx = canvas.getContext("2d", { alpha: false });

        if (!ctx) continue;

        // प्योर व्हाइट बैकग्राउंड
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // क्रिस्प टेक्स्ट रेंडरिंग
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";

        // @ts-ignore
        await page.render({
          canvasContext: ctx,
          viewport: viewport,
          intent: "print"
        }).promise;

        let bestBlob: Blob | null = null;

        if (mode === "target") {
          // सटीक बाइनरी सर्च
          let qLow = 0.25;
          let qHigh = 0.85;

          for (let iter = 0; iter < 4; iter++) {
            const qMid = (qLow + qHigh) / 2;
            const b: Blob = await new Promise((res) => {
              canvas.toBlob((bl) => res(bl!), "image/jpeg", qMid);
            });
            if (b.size <= perPageMaxBytes) {
              bestBlob = b;
              qLow = qMid;
            } else {
              qHigh = qMid;
            }
          }

          if (!bestBlob) {
            bestBlob = await new Promise((res) => {
              canvas.toBlob((bl) => res(bl!), "image/jpeg", 0.40);
            });
          }
        } else {
          // प्रीसेट मोड्स (High, Recommended, Small)
          bestBlob = await new Promise((res) => {
            canvas.toBlob((b) => res(b!), "image/jpeg", baseQuality);
          });
        }

        const imgBytes = await bestBlob!.arrayBuffer();
        const embeddedImg = await outPdfDoc.embedJpg(imgBytes);

        const outPage = outPdfDoc.addPage([originalViewport.width, originalViewport.height]);
        outPage.drawImage(embeddedImg, {
          x: 0,
          y: 0,
          width: originalViewport.width,
          height: originalViewport.height,
        });
      }

      setProgressText("दस्तावेज़ सुरक्षित किया जा रहा है...");
      const finalPdfBytes = await outPdfDoc.save({ useObjectStreams: true });
      let outputBlob = new Blob([finalPdfBytes], { type: "application/pdf" });

      // नो-इन्फ्लेशन सुरक्षा
      if (outputBlob.size >= file.size) {
        outputBlob = file;
      }

      const calculatedKb = Math.round(outputBlob.size / 1024);
      setCompressedSizeKb(calculatedKb);

      if (compressedPdfUrl) URL.revokeObjectURL(compressedPdfUrl);
      setCompressedPdfUrl(URL.createObjectURL(outputBlob));
    } catch (err) {
      console.error(err);
      alert("PDF कंप्रेस करने में समस्या आई। कृपया फ़ाइल पुनः जाँचें।");
    } finally {
      setIsProcessing(false);
      setProgressText("");
    }
  };

  return (
    <div className="min-h-screen bg-slate-50/50 text-slate-800 py-8 px-4 sm:px-6">
      <div className="max-w-xl mx-auto space-y-6">

        {/* Header */}
        <div className="text-center space-y-2">
          <span className="inline-flex items-center gap-1 bg-blue-50 text-blue-700 text-xs px-3 py-1 rounded-full font-bold border border-blue-100">
            <span className="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            क्रिस्प टेक्स्ट • स्मार्ट कम्प्रेशन
          </span>
          <h1 className="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            PDF कंप्रेसर
          </h1>
          <p className="text-xs sm:text-sm text-slate-500 font-medium">
            मार्कशीट, सर्टिफिकेट और फॉर्म की स्पष्टता बनाए रखते हुए सुरक्षित कंप्रेस करें
          </p>
        </div>

        {/* Main Card */}
        <div className="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200/80 shadow-sm space-y-6">

          {/* Upload Box */}
          <div className="space-y-2">
            <label className="block text-xs font-bold text-slate-700 uppercase tracking-wider">
              PDF फ़ाइल चुनें
            </label>

            <label
              htmlFor="pdf-compressor-file"
              className={`block w-full py-4 px-6 rounded-2xl font-black text-sm text-white shadow-lg cursor-pointer transition active:scale-98 ${
                isProcessing
                  ? "bg-slate-400 cursor-not-allowed"
                  : "bg-red-600 hover:bg-red-700 shadow-red-200"
              }`}
            >
              {isProcessing ? "PDF प्रोसेस हो रही है..." : "📁 PDF फ़ाइल चुनें"}
            </label>
            <input
              id="pdf-compressor-file"
              type="file"
              accept="application/pdf"
              onChange={handleFileChange}
              className="sr-only"
              disabled={isProcessing}
            />
          </div>

          {file && (
            <div className="space-y-5 animate-in fade-in duration-200">
              {/* 3 Compression Modes */}
              <div className="space-y-2">
                <label className="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                  कंप्रेशन लेवल चुनें
                </label>
                <div className="grid grid-cols-3 gap-2">
                  <button
                    type="button"
                    onClick={() => setMode("high")}
                    className={`p-3 rounded-2xl border text-center transition ${
                      mode === "high"
                        ? "border-blue-600 bg-blue-50/50 text-blue-900 shadow-sm"
                        : "border-slate-200 hover:border-slate-300 text-slate-700"
                    }`}
                  >
                    <div className="text-base mb-1">🟢</div>
                    <div className="text-xs font-bold">High Quality</div>
                    <div className="text-[10px] text-slate-400 mt-0.5">कम कम्प्रेशन, हाई स्पष्टता</div>
                  </button>

                  <button
                    type="button"
                    onClick={() => setMode("recommended")}
                    className={`p-3 rounded-2xl border text-center transition ${
                      mode === "recommended"
                        ? "border-blue-600 bg-blue-50/50 text-blue-900 shadow-sm"
                        : "border-slate-200 hover:border-slate-300 text-slate-700"
                    }`}
                  >
                    <div className="text-base mb-1">🟡</div>
                    <div className="text-xs font-bold">Recommended</div>
                    <div className="text-[10px] text-slate-400 mt-0.5">संतुलित साइज़ और क्वालिटी</div>
                  </button>

                  <button
                    type="button"
                    onClick={() => setMode("small")}
                    className={`p-3 rounded-2xl border text-center transition ${
                      mode === "small"
                        ? "border-blue-600 bg-blue-50/50 text-blue-900 shadow-sm"
                        : "border-slate-200 hover:border-slate-300 text-slate-700"
                    }`}
                  >
                    <div className="text-base mb-1">🔴</div>
                    <div className="text-xs font-bold">Small Size</div>
                    <div className="text-[10px] text-slate-400 mt-0.5">अधिकतम कम्प्रेशन</div>
                  </button>
                </div>

                <div className="pt-1">
                  <button
                    type="button"
                    onClick={() => setMode("target")}
                    className={`w-full py-2 px-3 text-xs font-bold rounded-xl border transition ${
                      mode === "target"
                        ? "border-blue-600 bg-blue-50 text-blue-700"
                        : "border-slate-200 text-slate-600 hover:bg-slate-50"
                    }`}
                  >
                    🎯 सटीक Target Size (KB) लॉक करें
                  </button>
                </div>
              </div>

              {/* Target Size Controls */}
              {mode === "target" && (
                <div className="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-3">
                  <div className="flex justify-between items-center text-xs">
                    <span className="font-bold text-slate-700">वांछित फ़ाइल साइज़:</span>
                    <span className="font-black text-blue-600 bg-white px-2 py-0.5 rounded-lg border border-slate-200">
                      {targetKb} KB
                    </span>
                  </div>

                  <div className="grid grid-cols-4 gap-2">
                    {[150, 200, 300, 500].map((kb) => (
                      <button
                        key={kb}
                        type="button"
                        onClick={() => setTargetKb(kb)}
                        className={`py-1.5 text-xs font-bold rounded-lg border ${
                          targetKb === kb
                            ? "bg-blue-600 text-white border-blue-600"
                            : "bg-white text-slate-700 border-slate-200 hover:border-slate-300"
                        }`}
                      >
                        {kb} KB
                      </button>
                    ))}
                  </div>

                  <input
                    type="range"
                    min={50}
                    max={Math.min(1000, originalSizeKb ? originalSizeKb - 10 : 800)}
                    value={targetKb}
                    onChange={(e) => setTargetKb(Number(e.target.value))}
                    className="w-full accent-blue-600 cursor-pointer"
                  />
                </div>
              )}

              {/* Compress Action Button */}
              <button
                type="button"
                onClick={processPdfCompression}
                disabled={isProcessing}
                className="w-full py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold text-sm shadow-md shadow-blue-200 transition disabled:opacity-50"
              >
                {isProcessing ? progressText || "प्रोसेसिंग..." : "PDF कंप्रेस करें"}
              </button>

              {/* Download Box */}
              {compressedPdfUrl && compressedSizeKb && (
                <div className="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl space-y-3">
                  <div className="flex items-center justify-between text-xs">
                    <span className="text-emerald-800 font-bold">✓ सफलतापूर्वक कंप्रेस हुआ!</span>
                    <span className="bg-emerald-600 text-white font-black px-2 py-0.5 rounded-md">
                      {compressedSizeKb} KB
                    </span>
                  </div>
                  <div className="text-[11px] text-emerald-700">
                    फ़ाइल साइज़: {originalSizeKb} KB ➔ <span className="font-bold">{compressedSizeKb} KB</span> (
                    {originalSizeKb ? Math.round(((originalSizeKb - compressedSizeKb) / originalSizeKb) * 100) : 0}% की बचत)
                  </div>
                  <a
                    href={compressedPdfUrl}
                    download={`compressed_${file.name}`}
                    className="block w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-center font-bold text-xs rounded-xl shadow-sm transition"
                  >
                    ⬇️ कंप्रेस की गई PDF डाउनलोड करें
                  </a>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
